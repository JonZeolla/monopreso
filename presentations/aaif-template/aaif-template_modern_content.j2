     eyebrow="CONTRACT · PROS/CONS") %}
{{ pros_cons(
  [
    {"title": "One contract",   "detail": "Nine macro signatures. A slide written once renders in any pack."},
    {"title": "No hex codes",   "detail": "Shared slides name accents semantically; the pack resolves them."},
    {"title": "Swap in a line", "detail": "The deck's Taskfile picks the brand. Nothing else changes."},
  ],
  [
    {"title": "Contract drift",      "detail": "Adding a primitive means updating every pack, not just yours."},
    {"title": "Lowest common shape", "detail": "A layout only one brand can express does not belong in the contract."},
  ]) }}
{% endcall %}

{% call content_slide(
