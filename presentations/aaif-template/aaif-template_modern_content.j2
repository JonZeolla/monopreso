  {"title": "Accent: success",   "body": "Green. Reserved for outcomes that went right.",          "accent": "success"},
  {"title": "Accent: warning",   "body": "Amber. A caveat the audience has to carry forward.",     "accent": "warning"},
  {"title": "Accent: danger",    "body": "Red. Something that actually breaks.",                   "accent": "danger"},
  {"title": "Accent: neutral",   "body": "Hairline grey. The right choice most of the time.",      "accent": "neutral"},
], cols=3) }}
{% endcall %}

{% call content_slide(
