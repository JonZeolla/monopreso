           autoplay loop muted playsinline preload="metadata"
           aria-label="Before and after: a sticky-session load balancer pinning a client to one instance, versus round-robin across three instances"></video>
    <p class="aaif-label aaif-label--sm" style="text-transform:none;">
      Source: blog.modelcontextprotocol.io/posts/2026-07-28/
    </p>
  </div>
{% endcall %}


{% call content_slide("Multi Round-Trip Requests (MRTR)",
                      "Replaces server-initiated elicitation/create, sampling/createMessage, and roots/list (SEP-2322)",
                      label="⚠️ Breaking change",
                      eyebrow="03 · MCP SPEC") %}
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:calc(16 * var(--pt)); align-items:start;">
    {{ code_block("server responds", [
         '"result": {',
         '  "resultType": "input_required",',
         '  "inputRequests": {',
         '    "github_login": {',
         '      "method": "elicitation/create",',
         '      "params": { ... }',
         '    }',
         '  },',
         '  "requestState": "AEAD-protected blob"',
         '}',
       ]) }}
    {{ code_block("client retries with a new id", [
         '"method": "tools/call",',
         '"id": 2,',
         '"params": {',
         '  ...,',
         '  "inputResponses": {',
         '    "github_login": { "action": "accept", ... }',
         '  },',
         '  "requestState": "AEAD-protected blob"',
         '}',
       ]) }}
  </div>
  <p class="aaif-card-body" style="margin-top:calc(10 * var(--pt)); font-size:calc(9 * var(--pt));">
    No longer requires long-held connections.
  </p>
{% endcall %}


{% call content_slide("Stateless everywhere",
                      eyebrow="03 · MCP SPEC") %}
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:calc(18 * var(--pt)); align-items:start;">
    <div>
      <p class="aaif-label aaif-label--sm">Before · stateful (SSE)</p>
      <pre class="mermaid" style="background:transparent; margin-top:calc(6 * var(--pt));">
sequenceDiagram
  participant C as Client
  participant LB as Load Balancer (sticky)
  participant A as Instance A
  C->>LB: tools/call
  LB->>A: routed, session pinned to A
  A-->>C: server-initiated elicitation/create<br/>pushed down a held-open stream
  Note over A: A holds the in-flight call<br/>and the open stream
  C-->>A: elicitation result, which must reach A
  A-->>C: tool result
  Note over LB,A: Needs sticky routing or shared storage.<br/>Lose the stream and the call is lost
      </pre>
    </div>
    <div>
      <p class="aaif-label aaif-label--sm">After · MRTR</p>
      <pre class="mermaid" style="background:transparent; margin-top:calc(6 * var(--pt));">
sequenceDiagram
  participant U as User
  participant C as Client
  participant S as Server (any instance)
  C->>S: tools/call (id 1)
  S-->>C: InputRequiredResult (id 1)<br/>resultType input_required + requestState
  Note over S: Request ends here.<br/>Nothing is held in server memory
  C->>U: prompt for the requested input
  U-->>C: answers
  C->>S: tools/call (id 2) + inputResponses + requestState
  Note over S: Any instance. State arrives in the<br/>echoed blob, which is untrusted input
  S-->>C: Result (id 2)
      </pre>
    </div>
  </div>
{% endcall %}


{% call content_slide("DCR is deprecated in favour of CIMD",
                      "With Client ID Metadata Documents the client_id is an HTTPS URL the client controls (SEP-2352)",
                      label="⚠️ Deprecation",
                      eyebrow="03 · MCP SPEC") %}
  {{ pros_cons(
       [
         {"title": "No registration step",
          "detail": "One client_id works at every AS that supports CIMD."},
         {"title": "Identity is verifiable",
          "detail": "Domain control backs the client's identity."},
         {"title": "Updates propagate",
          "detail": "Every AS reads the new metadata on its next fetch."},
       ],
       [
         {"title": "A row per client, per server",
          "detail": "Each client gets a minted, non-portable client_id."},
         {"title": "Registrations outlive the client",
          "detail": "Stale client records accumulate silently."},
         {"title": "Anyone can register",
          "detail": "The consent-screen name and logo are attacker-supplied."},
       ],
       "Benefits · CIMD", "Drawbacks · DCR") }}
{% endcall %}


{% call content_slide("DCR vs CIMD",
                      eyebrow="03 · MCP SPEC") %}
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:calc(18 * var(--pt)); align-items:start;">
    <div>
      <p class="aaif-label aaif-label--sm">DCR (RFC 7591)</p>
      <pre class="mermaid" style="background:transparent; margin-top:calc(6 * var(--pt));">
sequenceDiagram
  participant C as MCP Client
  participant AS as Authorization Server
  C->>AS: GET authorization server metadata (RFC 8414)
  AS-->>C: metadata incl. registration_endpoint
  C->>AS: POST /register (client_name, redirect_uris)
  Note over AS: AS writes a client record,<br/>one row per client, per AS
  AS-->>C: client_id (+ client_secret)
  Note over C,AS: The minted client_id is local:<br/>it isn't portable to another AS
  C->>AS: /authorize?client_id=(minted)
  AS-->>C: consent screen shows self-asserted client_name
      </pre>
    </div>
    <div>
      <p class="aaif-label aaif-label--sm">CIMD (draft)</p>
      <pre class="mermaid" style="background:transparent; margin-top:calc(6 * var(--pt));">
sequenceDiagram
  participant C as MCP Client
  participant M as Metadata URL (client-hosted)
  participant AS as Authorization Server
  Note over C,M: Client already hosts metadata JSON at a<br/>stable HTTPS URL, and that URL is the client_id
  C->>AS: /authorize?client_id=https://client.dev/oauth/metadata.json
  Note over AS: client_id is a URL, so fetch it.<br/>No registration record is written
  AS->>M: GET the client_id URL
  M-->>AS: client_id, client_name, client_uri, redirect_uris
  Note over AS: 200 only, no redirects followed.<br/>Document client_id MUST equal the URL
  AS-->>C: consent screen shows fetched client_name
      </pre>
    </div>
  </div>
{% endcall %}


{% call content_slide("Smaller changes",
                      eyebrow="03 · MCP SPEC") %}
  {{ card_grid([
       {"title": "Header-based routing", "accent": "primary",
        "body": "Streamable HTTP requests now carry Mcp-Method and Mcp-Name headers, so gateways, rate limiters, and WAFs route and meter without parsing JSON bodies (SEP-2243). We'll use this in the agentgateway lab."},
       {"title": "Cacheable list results", "accent": "neutral",
        "body": "tools/list, prompts/list, resources/list, and resources/read responses include ttlMs and cacheScope, enabling deterministic ordering and stable prompt caches across reconnects (SEP-2549)."},
       {"title": "Issuer validation", "accent": "warning",
        "body": "Authorization servers must return the RFC 9207 iss parameter and clients must validate it before code redemption, closing a mix-up attack class (SEP-2468)."},
     ], cols=3) }}
{% endcall %}


