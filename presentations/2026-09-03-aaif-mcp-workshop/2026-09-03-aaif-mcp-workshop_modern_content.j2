{%- macro lab_links_slide(title, left, right, subtitle="", label="", eyebrow="") -%}
{% call content_slide(title, subtitle, label=label, eyebrow=eyebrow) %}
  <div style="display:grid; grid-template-columns:1fr calc(1.2 * var(--pt)) 1fr; align-items:stretch; height:92%;">
