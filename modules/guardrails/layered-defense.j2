{#- modules/guardrails/layered-defense.j2
    Shared slide content extracted from 2026-06-coding-guardrails.
    Currently emits sans-cloud-flavored HTML (vis-* classes); valid under
    branding="sans-cloud". Future work: replace inline markup with brand-pack
    primitive calls so this content renders under any brand. See AGENTS.md. -#}

{%- macro layered_defense() -%}
<section class="vis-slide" data-label="Layered Defense">
  <div class="vis-label">Complementary Controls</div>
  <div class="vis-title">Deterministic + AI</div>

  <div class="vis-grid-2" style="flex:1; gap:32px;">

    <div>
      <div style="margin-bottom:14px;">
        <p style="font-size:13px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#2dd4bf; margin:0;">Deterministic</p>
      </div>

      <p style="font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#22c55e; margin:14px 0 10px 0;">Benefits</p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="padding:12px 14px; border-radius:12px; background:rgba(34,197,94,0.05); border:1px solid rgba(34,197,94,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Deterministic &amp; reproducible</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Same input, same result, every time.</p>
        </div>
        <div style="padding:12px 14px; border-radius:12px; background:rgba(34,197,94,0.05); border:1px solid rgba(34,197,94,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Fast &amp; cheap</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Runs in ms, no LLM cost, scales horizontally.</p>
        </div>
        <div style="padding:12px 14px; border-radius:12px; background:rgba(34,197,94,0.05); border:1px solid rgba(34,197,94,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Whole-repo scope</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Scans every line, every run — not just the diff.</p>
        </div>
      </div>

      <p style="font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#f87171; margin:18px 0 10px 0;">Drawbacks</p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="padding:12px 14px; border-radius:12px; background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Only known patterns</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">No rule, no finding. Novel issues slip through.</p>
        </div>
        <div style="padding:12px 14px; border-radius:12px; background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Hard to write</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Rego, Semgrep DSL — niche languages, AI is bad at them.</p>
        </div>
        <div style="padding:12px 14px; border-radius:12px; background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Rules age &amp; drift</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Must keep pace with the codebase or lose value.</p>
        </div>
      </div>
    </div>

    <div>
      <div style="margin-bottom:14px;">
        <p style="font-size:13px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#c084fc; margin:0;">AI Review</p>
      </div>

      <p style="font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#22c55e; margin:14px 0 10px 0;">Benefits</p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="padding:12px 14px; border-radius:12px; background:rgba(34,197,94,0.05); border:1px solid rgba(34,197,94,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Reasons about intent + context</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Reads the diff like a teammate; understands the change.</p>
        </div>
        <div style="padding:12px 14px; border-radius:12px; background:rgba(34,197,94,0.05); border:1px solid rgba(34,197,94,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Catches novel issues</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Finds shapes no rule covers — including subtle logic flaws.</p>
        </div>
        <div style="padding:12px 14px; border-radius:12px; background:rgba(34,197,94,0.05); border:1px solid rgba(34,197,94,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Suggests fixes</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Actionable patches, not just flags. Adapts to your codebase.</p>
        </div>
      </div>

      <p style="font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#f87171; margin:18px 0 10px 0;">Drawbacks</p>
      <div style="display:flex; flex-direction:column; gap:10px;">
        <div style="padding:12px 14px; border-radius:12px; background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Non-deterministic</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">Same diff may flag different things on different runs.</p>
        </div>
        <div style="padding:12px 14px; border-radius:12px; background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Slower &amp; costs $</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">LLM compute adds latency and per-review dollar cost.</p>
        </div>
        <div style="padding:12px 14px; border-radius:12px; background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.2);">
          <p style="font-size:13px; font-weight:600; color:#fff; margin:0;">Can hallucinate</p>
          <p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">May fabricate findings — or miss real ones.</p>
        </div>
      </div>
    </div>
  </div>

</section>
{%- endmacro -%}
