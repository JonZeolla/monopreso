{#- modules/identity/aauth.j2
    Sources: Zenable lab aauth-agent-authorization.mdx; IETF Internet-Draft
    draft-hardt-oauth-aauth-protocol (Dick Hardt) -- a LIVE PROPOSAL, not a standard.
    The OAuth 2.1 column is the draft-ietf-oauth-v2-1 baseline. Import WITH CONTEXT.
      {%- from "modules/identity/aauth.j2" import what_it_is, versus_oauth, access_modes with context %}
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import
    content_slide, slide_heading, card_grid, matrix, pipe, callout
-%}

{%- macro what_it_is() -%}
{%- call content_slide("What AAuth is") %}
  {{ slide_heading("", "AAuth: a signature instead of a key") }}
  {{ card_grid([
    {"title": "The agent holds a private key",
     "body": "The public half is published at a URL the agent controls. Publishing it is the enrollment.",
     "accent": "primary"},
    {"title": "Every request is signed",
     "body": "The signature covers method, target, and selected headers. No shared secret on the wire.",
     "accent": "info"},
    {"title": "A person is added only when needed",
     "body": "A Person Server vouches for who the agent acts for and collects consent.",
     "accent": "success"},
  ], cols=3) }}
  {{ callout("A signature answers <strong>who is calling</strong>. Whether they may do it is a separate question.", accent="warning") }}
{%- endcall %}
{%- endmacro -%}


{%- macro versus_oauth() -%}
{%- call content_slide("AAuth versus OAuth 2.1") %}
  {{ slide_heading("", "What AAuth does that OAuth 2.1 does not") }}
  {{ matrix(
       headers=[
         {"label": "OAuth 2.1", "sub": "draft"},
         {"label": "AAuth",     "sub": "proposal"},
       ],
       rows=[
         {"label": "Caller identity",
          "cells": [
            {"level": "partial", "text": "a registered client"},
            {"level": "strong",  "text": "the agent itself"},
          ]},
         {"label": "Credential on the wire",
          "cells": [
            {"level": "weak",   "text": "bearer token"},
            {"level": "strong", "text": "a per-request signature"},
          ]},
         {"label": "Registration",
          "cells": [
            {"level": "weak",   "text": "pre-registered or DCR"},
            {"level": "strong", "text": "publish a key, no registration"},
          ]},
         {"label": "Per-request binding",
          "cells": [
            {"level": "weak",   "text": "none by default"},
            {"level": "strong", "text": "method and target signed"},
          ]},
         {"label": "Authorization timing",
          "cells": [
            {"level": "partial", "text": "consent up front"},
            {"level": "strong",  "text": "in the moment, even per call"},
          ]},
         {"label": "Hand-off between parties",
          "cells": [
            {"level": "partial", "text": "separate trust per server"},
            {"level": "strong",  "text": "across orgs via Access Server"},
          ]},
       ],
       caption="● strong &nbsp;·&nbsp; ◐ partial &nbsp;·&nbsp; ○ weak") }}
{%- endcall %}
{%- endmacro -%}


{%- macro access_modes() -%}
{%- call content_slide("AAuth use cases") %}
  {{ slide_heading("", "AAuth use cases") }}
  {#- Six modes, each adding one capability to the one before it (aauth.dev).
      Identity Based and Person Identity differ in WHO the resource learns
      about: the agent, or the person the agent acts for. -#}
  {{ card_grid([
    {"title": "Which agent is calling",       "body": "", "accent": "neutral"},
    {"title": "Resource-issued session",      "body": "", "accent": "neutral"},
    {"title": "Which person it acts for",     "body": "", "accent": "neutral"},
    {"title": "Person Server decides access", "body": "", "accent": "neutral"},
    {"title": "Federated across orgs",        "body": "", "accent": "neutral"},
    {"title": "Consent per call",             "body": "", "accent": "neutral"},
  ], cols=3, size="lg") }}
{%- endcall %}
{%- endmacro -%}
