{#- modules/identity/a2a-trust.j2
    Sources: A2A specification v1.0.1 (a2a-protocol.org/latest/specification, §8 Agent
    Discovery; field names from specification/a2a.proto at tag v1.0.1: provider,
    supported_interfaces, security_schemes, security_requirements, skills[].security_requirements,
    signatures). Signing is a MAY (§8.4), JWS over the JCS-canonical card (§8.4.1); the key
    comes from the header's jku or a trusted key store (§8.4.3). RFC 8693 for token exchange.
    Import WITH CONTEXT.
      {%- from "modules/identity/a2a-trust.j2" import agent_cards with context %}
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import
    content_slide, slide_heading
-%}

{%- macro agent_cards() -%}
{%- call content_slide("A2A Agent Cards") %}
<style>
  .a2a-card { max-width: 60rem; margin: 1.25rem auto 0; border: 1.5px solid var(--slide-rule); border-radius: 1.25rem;
              background: var(--slide-surface); overflow: hidden; font-size: 1.15rem; }
  .a2a-head { display: flex; align-items: center; gap: 1.25rem; padding: 1.25rem 1.75rem;
              background: color-mix(in srgb, var(--accent-primary) 12%, transparent);
              border-bottom: 1px solid var(--slide-hairline); }
  .a2a-head .ava { width: 4.25rem; height: 4.25rem; border-radius: 1rem; flex: none; display: grid; place-items: center;
                   color: var(--accent-primary); border: 2px solid var(--accent-primary);
                   background: color-mix(in srgb, var(--accent-primary) 14%, transparent); }
  .a2a-head .ava svg { width: 2.4rem; height: 2.4rem; }
  .a2a-head .name { font-size: 1.9rem; font-weight: 800; color: var(--slide-ink); line-height: 1.1; }
  .a2a-head .by { color: var(--slide-ink-2); margin-top: .25rem; }
  .a2a-head .by b { color: var(--slide-ink); font-weight: 600; }
  .a2a-head .proto { margin-left: auto; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85rem;
                     letter-spacing: .08em; color: var(--slide-ink-3); border: 1px solid var(--slide-hairline);
                     border-radius: 999px; padding: .3rem .8rem; white-space: nowrap; }
  .a2a-rows { display: grid; }
  .a2a-row { display: grid; grid-template-columns: 3.25rem 14rem 1fr; gap: 1rem; align-items: center;
             padding: 1rem 1.75rem; border-bottom: 1px solid var(--slide-hairline); }
  .a2a-row:last-child { border-bottom: 0; }
  .a2a-row .ic { width: 2.6rem; height: 2.6rem; border-radius: 50%; display: grid; place-items: center; color: var(--c);
                 background: color-mix(in srgb, var(--c) 14%, transparent); border: 1.5px solid color-mix(in srgb, var(--c) 45%, transparent); }
  .a2a-row .ic svg { width: 1.35rem; height: 1.35rem; }
  .a2a-row .k { font-size: .8rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--slide-ink-3); }
  .a2a-row .k small { display:block; margin-top:.2rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .75rem; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--slide-ink-3); opacity: .8; }
  .a2a-head .by small { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85em; color: var(--slide-ink-3); }
  .a2a-row .v { color: var(--slide-ink); line-height: 1.4; }
  .a2a-row .v code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .9em; color: var(--slide-ink-2); }
  .a2a-row .v .sc { display:inline-block; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .8em;
                    padding: .1em .55em; border-radius: 999px; border: 1px solid color-mix(in srgb, var(--c) 50%, transparent);
                    color: var(--c); margin-left: .35rem; }
  .a2a-card svg { fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .a2a-foot { text-align: center; margin-top: 1rem; color: var(--slide-ink-3); font-size: 1rem; }
  .a2a-foot code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
</style>
{{ slide_heading("", "A2A Agent Cards") }}
{#- The card is the agent's self-description, served at a well-known URL. Rows
    follow the A2A 1.0 field groups (who it is / where to reach it / what it
    demands / what it offers) plus the signature, one press each. Field names
    are the proto's: provider, supportedInterfaces, securitySchemes,
    securityRequirements, skills, signatures. -#}
<div class="a2a-card">
  <div class="a2a-head">
    <span class="ava"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="8" width="14" height="11" rx="3"/><circle cx="9.5" cy="13.5" r="1.2" fill="currentColor" stroke="none"/><circle cx="14.5" cy="13.5" r="1.2" fill="currentColor" stroke="none"/><path d="M12 8V4M9 4h6"/></svg></span>
    <div>
      <div class="name">Forecast Agent</div>
      <div class="by"><small>provider</small> <b>Example Corp</b> &middot; example.com &nbsp;<small>(claimed)</small></div>
    </div>
    <span class="proto">version 1.4.0</span>
  </div>
  <div class="a2a-rows">
    <div class="a2a-row step" style="--c: var(--accent-info);">
      <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c3 3.5 3 14.5 0 18M12 3c-3 3.5-3 14.5 0 18"/></svg></span>
      <span class="k">Where to reach it<small>supportedInterfaces</small></span>
      <span class="v"><code>https://forecast.example.com/</code> &middot; JSONRPC 1.0</span>
    </div>
    <div class="a2a-row step" style="--c: var(--accent-primary);">
      <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
      <span class="k">What it demands<small>securitySchemes, securityRequirements</small></span>
      <span class="v">OpenID Connect, discovered at <code>idp.example.com</code></span>
    </div>
    <div class="a2a-row step" style="--c: var(--accent-success);">
      <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="8" width="18" height="12" rx="2"/><path d="M9 8V6a3 3 0 0 1 6 0v2M3 13h18"/></svg></span>
      <span class="k">What it offers<small>skills, each may carry its own requirements</small></span>
      <span class="v">forecast <span class="sc">forecast:read</span><br>update_model <span class="sc">forecast:write</span></span>
    </div>
    <div class="a2a-row step" style="--c: var(--accent-secondary);">
      <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 20l4-1L18 8l-3-3L4 16z"/><path d="M13 7l3 3"/></svg></span>
      <span class="k">Who signed it<small>signatures</small></span>
      <span class="v">A JWS over the canonical card. The key comes from the header&rsquo;s <code>jku</code> or from a key store <em>you</em> trust. Keep the store.</span>
    </div>
  </div>
</div>
{%- endcall %}
{%- endmacro -%}
