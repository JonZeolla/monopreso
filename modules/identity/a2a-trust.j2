{#- modules/identity/a2a-trust.j2
    Sources: Zenable lab a2a-agent-interop.mdx (A2A protocol 1.0); RFC 8693 for token exchange.
    Import WITH CONTEXT.
      {%- from "modules/identity/a2a-trust.j2" import agent_cards, three_identities, rogue_card with context %}
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import
    content_slide, slide_heading, card_grid, numbered_steps, callout
-%}

{%- macro agent_cards() -%}
{%- call content_slide("A2A Agent Cards") %}
  {{ slide_heading("", "A2A Agent Cards") }}
  {#- An illustrative A2A 1.0 card, built from the Zenable a2a lab and the
      A2A spec fields a security reviewer reads first. Each outlined box is one
      click: who owns it, where it listens, how callers authenticate, what each
      skill needs, and whether the card is signed. Box positions are line
      numbers x 1.5em, so edit the card and the boxes together. -#}
  <div style="position:relative; margin-top:1.25rem; font-size:0.9em;">
  <pre style="margin:0; padding:1.1em 1.5em; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; line-height:1.5; border:1px solid rgba(128,128,128,0.35); background:rgba(128,128,128,0.08); border-radius:0.75rem; overflow:hidden;">{% raw %}{
  "name": "Forecast Agent",
  "provider": { "organization": "Example Corp", "url": "https://example.com" },
  "supportedInterfaces": [
    { "url": "https://forecast.example.com/",
      "protocolBinding": "JSONRPC",
      "protocolVersion": "1.0" }
  ],
  "capabilities": { "streaming": true, "pushNotifications": false },
  "securitySchemes": {
    "idp": { "openIdConnectSecurityScheme": {
      "openIdConnectUrl": "https://idp.example.com/.well-known/openid-configuration" } }
  },
  "securityRequirements": [
    { "schemes": { "idp": { "list": ["forecast:read"] } } }
  ],
  "skills": [
    { "id": "forecast",
      "securityRequirements": [
        { "schemes": { "idp": { "list": ["forecast:read"] } } } ] },
    { "id": "update_model",
      "securityRequirements": [
        { "schemes": { "idp": { "list": ["forecast:write"] } } } ] }
  ],
  "signatures": [
    { "protected": "eyJhbGciOiJFUzI1NiIs...", "signature": "MEUCIQ..." }
  ]
}{% endraw %}</pre>
    <div class="step" style="position:absolute; left:0.5em; right:0.5em; top:calc(1.1em + 2*1.5em - 0.1em); height:calc(1*1.5em + 0.2em); border:2px solid currentColor; border-radius:0.5rem; pointer-events:none;"></div>
    <div class="step" style="position:absolute; left:0.5em; right:0.5em; top:calc(1.1em + 3*1.5em - 0.1em); height:calc(5*1.5em + 0.2em); border:2px solid currentColor; border-radius:0.5rem; pointer-events:none;"></div>
    <div class="step" style="position:absolute; left:0.5em; right:0.5em; top:calc(1.1em + 9*1.5em - 0.1em); height:calc(4*1.5em + 0.2em); border:2px solid currentColor; border-radius:0.5rem; pointer-events:none;"></div>
    <div class="step" style="position:absolute; left:0.5em; right:0.5em; top:calc(1.1em + 17*1.5em - 0.1em); height:calc(6*1.5em + 0.2em); border:2px solid currentColor; border-radius:0.5rem; pointer-events:none;"></div>
    <div class="step" style="position:absolute; left:0.5em; right:0.5em; top:calc(1.1em + 24*1.5em - 0.1em); height:calc(3*1.5em + 0.2em); border:2px solid currentColor; border-radius:0.5rem; pointer-events:none;"></div>
  </div>
{%- endcall %}
{%- endmacro -%}


{%- macro three_identities() -%}
{%- call content_slide("Three identities") %}
  {{ slide_heading("", "Three identities that get collapsed into one") }}
  {{ numbered_steps([
    {"title": "The calling agent",
     "detail": "A workload with a service account. No human, no browser.",
     "accent": "primary"},
    {"title": "The end user it acts for",
     "detail": "Their permissions should bound the work. Use OAuth token exchange (RFC 8693).",
     "accent": "info"},
    {"title": "The operator or tenant",
     "detail": "The organization whose policy applies.",
     "accent": "warning"},
  ]) }}
{%- endcall %}
{%- endmacro -%}


{%- macro rogue_card() -%}
{%- call content_slide("The rogue card") %}
  {{ slide_heading("", "A copied card steals real tokens") }}
  {{ card_grid([
    {"title": "The attack",
     "body": "A client that obeys the card sends its credential to whoever the card names.",
     "accent": "danger"},
    {"title": "The fix",
     "body": "Pin the key you trust. Never follow the key the card names.",
     "accent": "success"},
    {"title": "The check people skip",
     "body": "Audience. Without it, every agent accepts every other agent&rsquo;s token.",
     "accent": "warning"},
  ], cols=3) }}
{%- endcall %}
{%- endmacro -%}
