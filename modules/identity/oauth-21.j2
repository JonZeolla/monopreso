{#- modules/identity/oauth-21.j2
    Sources: draft-ietf-oauth-v2-1-16 (3 Sept 2026; an IETF DRAFT, not yet a standard).
    Baseline: PKCE MUST is §4.1.1 (authorization code only, §7.5.1 exemption); exact
    redirect matching §2.3.1; no tokens in query strings §5.1; implicit/ROPC "not
    specified" §1.8. Gap quotes are verbatim from the cited sections (unchanged -15→-16).
    Primitive-native: import WITH CONTEXT.
      {%- from "modules/identity/oauth-21.j2" import baseline, gaps_for_agents with context %}
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import
    content_slide, slide_heading, card_grid, callout
-%}

{%- macro baseline() -%}
{%- call content_slide("OAuth 2.1 baseline") %}
  {{ slide_heading("", "OAuth 2.1 is the current Agent foundation") }}
  {{ card_grid([
    {"title": "Requires PKCE for the authorization code flow", "body": "", "accent": "primary"},
    {"title": "Exact redirect URI matching, no bearer tokens in URLs", "body": "", "accent": "info"},
    {"title": "Drops the implicit and resource owner password grants", "body": "", "accent": "danger"},
  ], cols=1, size="lg") }}
  <p class="step" style="margin-top:2rem; font-size:2em; font-weight:700; text-align:center;">But it&rsquo;s still a draft?!</p>
{%- endcall %}
{%- endmacro -%}


{%- macro gaps_for_agents() -%}
{%- call content_slide("OAuth 2.1 gaps") %}
  {{ slide_heading("", "Downsides when used with Agents") }}
  {{ card_grid([
    {"title": "Bearer tokens can be replayed by default",
     "body": "<em>&sect;1.4.2: usable &ldquo;in any way that any other party in possession of it can.&rdquo; Fix: sender-constrain it (&sect;1.4.3).</em>",
     "accent": "danger"},
    {"title": "Clients need pre-registration or DCR",
     "body": "<em>&sect;2: &ldquo;the client must have established an identifier.&rdquo; DCR (RFC 7591) does it at runtime, no pre-registration.</em>",
     "accent": "warning"},
    {"title": "Approvals expect a human in the loop",
     "body": "<em>&sect;4.1: the server talks to the resource owner &ldquo;to get consent for resource access.&rdquo;</em>",
     "accent": "info"},
    {"title": "Attribution per call is per client, not per agent",
     "body": "<em>&sect;1.4: a token is &ldquo;an authorization issued to the client.&rdquo; &sect;2.2: the client_id names the client.</em>",
     "accent": "primary"},
  ], cols=2) }}
  <p style="margin-top:1.5rem; text-align:center; font-size:0.9em;">
    Section numbers: <a href="https://datatracker.ietf.org/doc/html/draft-ietf-oauth-v2-1-16" target="_blank" rel="noopener" style="text-decoration:underline;">draft-ietf-oauth-v2-1-16 (September 2026)</a>
  </p>
{%- endcall %}
{%- endmacro -%}
