{#- modules/identity/dpop.j2
    Sources: Zenable lab agent-identity-dpop-sdjwt.mdx; RFC 9449 (DPoP), RFC 9901 (SD-JWT).
    Import WITH CONTEXT.
      {%- from "modules/identity/dpop.j2" import how_it_works, what_it_refuses with context %}
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import
    content_slide, slide_heading, pipe, pros_cons
-%}

{%- macro how_it_works() -%}
{%- call content_slide("DPoP") %}
  {{ slide_heading("", "Demonstrating Proof of Possession (DPoP)") }}
  {{ pipe([
    {"label": "Bind a token to a key when it&rsquo;s issued",
     "accent": "primary"},
    {"label": "During each request, re-sign the JWT using the private key",
     "accent": "info"},
    {"label": "Verify at the resource server (not the IdP)",
     "accent": "success"},
  ]) }}
{%- endcall %}
{%- endmacro -%}


{%- macro what_it_refuses() -%}
{%- call content_slide("When to use DPoP") %}
  {{ slide_heading("", "When to use this") }}
  {{ pros_cons(
    benefits=[
      {"title": "Replay of a stolen token", "detail": "A repeated <code>jti</code> or a stale <code>iat</code> is refused."},
      {"title": "Wrong target or token", "detail": "Mismatched <code>htu</code>, <code>htm</code>, or <code>ath</code>."},
      {"title": "Algorithm tricks", "detail": "Symmetric-algorithm confusion fails an allowlist."},
      {"title": "Downgrade", "detail": "An unbound token on a strict endpoint."},
    ],
    shortcomings=[
      {"title": "Forged tokens", "detail": "Storm-0558 stole a signing key and minted its own."},
      {"title": "A stolen private key", "detail": "Whoever holds the key can sign valid proofs."},
      {"title": "A misbehaving agent", "detail": "It still holds a valid key and token."},
    ],
    ben_label="What DPoP prevents",
    short_label="What it doesn&rsquo;t") }}
{%- endcall %}
{%- endmacro -%}
