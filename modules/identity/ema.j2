{#- modules/identity/ema.j2
    Sources: Zenable lab mcp-authorization-101.mdx; MCP Enterprise-Managed Authorization
    extension; ID-JAG is an IETF draft (draft-ietf-oauth-identity-assertion-authz-grant);
    RFC 8693, RFC 7523, RFC 8707. Import WITH CONTEXT.
      {%- from "modules/identity/ema.j2" import problem, id_jag_flow with context %}
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import
    content_slide, slide_heading, numbered_steps, pipe, callout
-%}

{%- macro problem() -%}
{%- call content_slide("Per-server OAuth") %}
  {{ slide_heading("", "Why per-server OAuth breaks in an enterprise",
                   "Every developer authenticates and consents at every MCP server.") }}
  {{ numbered_steps([
    {"title": "The user is the policy decision point",
     "detail": "The consent screen asks the developer, not your admins.", "accent": "danger"},
    {"title": "Deprovisioning does not propagate",
     "detail": "Disable someone in the IdP and tokens at each vendor live on until they expire.", "accent": "warning"},
    {"title": "Access cannot be enumerated",
     "detail": "The grants sit in vendor databases you do not control.", "accent": "info"},
    {"title": "Nowhere to configure it centrally, and users choose scopes",
     "detail": "Each vendor is set up per user, and the developer picks what to approve.", "accent": "secondary"},
  ]) }}
{%- endcall %}
{%- endmacro -%}


{%- macro id_jag_flow() -%}
{%- call content_slide("Enterprise-Managed Authorization") %}
  {{ slide_heading("", "Enterprise-Managed Authorization",
                   "The admin&rsquo;s IdP makes the decision. The ID-JAG grant carries it.") }}
  {{ pipe([
    {"label": "Sign in once",
     "detail": "Corporate SSO at the IdP. No per-vendor consent screen.",
     "accent": "info"},
    {"label": "Get an ID-JAG",
     "detail": "Token exchange (RFC 8693) at the IdP. Scopes capped by admin policy.",
     "accent": "primary"},
    {"label": "Redeem it",
     "detail": "Present it to the vendor&rsquo;s server (RFC 7523) for a token bound to one MCP server (RFC 8707).",
     "accent": "success"},
  ]) }}
  {{ callout("Admin policy is the <strong>scope ceiling</strong>. The ID-JAG format is still an IETF draft.", accent="primary") }}
{%- endcall %}
{%- endmacro -%}
