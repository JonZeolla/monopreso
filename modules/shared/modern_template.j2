<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <!-- modern.css is a build artifact generated by Tailwind from modern-input.css (see start.sh) -->
    <link rel="stylesheet" href="modules/shared/css/modern.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        html { scroll-behavior: smooth; }
        .slide {
            min-height: 100vh;
            scroll-snap-align: start;
        }
        .scroll-container {
            scroll-snap-type: y mandatory;
            overflow-y: scroll;
            height: 100vh;
        }
        .fade-in { animation: fadeIn 0.6s ease-out; }
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        /* Progressive disclosure: elements with .step inside a slide are
           revealed one per ArrowDown before advancing to the next slide.
           visibility (not display) so layout space is reserved up front. */
        .step { visibility: hidden; }
        .step.step-visible { visibility: visible; animation: fadeIn 0.4s ease-out; }
        /* Swap: two blocks stacked in one grid cell. The .swap-out block is
           the slide as it opens; when the slide's .step lands it fades away
           and the step takes its place, in the same spot. The cell is as tall
           as the taller block, so nothing on the slide moves. */
        .swap-stack { display: grid; }
        .swap-stack > * { grid-area: 1 / 1; align-self: start; }
        .swap-out { transition: opacity 0.3s ease; }
        .slide:has(.step.step-visible) .swap-out { opacity: 0; visibility: hidden; }
        /* Focus sequence: sibling beats marked .focus-step recede once a LATER
           one has been revealed, so the beat under discussion is the bright one
           and the ones already covered stay readable behind it. The first beat
           is usually .focus-step alone (visible on open); the rest add .step. */
        .focus-step { transition: opacity 0.3s ease; }
        .focus-step:has(~ .focus-step.step-visible) { opacity: 0.32; }

        /* ── Slide colour tokens ────────────────────────────────────────
           Slides that emit their own markup (charts, code cards, the
           requirement and profile modules) take their text and surface
           colours from these rather than hard-coding a hex, so light mode is
           one variable flip instead of an override per element. Brand accents
           are NOT here — those stay owned by the brand pack. */
        :root {
          --slide-ink:      #f1f5f9;   /* primary text            */
          --slide-ink-2:    #94a3b8;   /* secondary / body        */
          --slide-ink-3:    #64748b;   /* muted / captions        */
          --slide-surface:  rgba(29,41,57,0.55);
          --slide-sunken:   rgba(2,6,23,0.55);
          --slide-hairline: rgba(148,163,184,0.16);
          --slide-rule:     rgba(100,116,139,0.28);
        }
        body.light-mode {
          --slide-ink:      #0f172a;
          --slide-ink-2:    #475569;
          --slide-ink-3:    #64748b;
          --slide-surface:  rgba(241,245,249,0.85);
          --slide-sunken:   rgba(241,245,249,0.95);
          --slide-hairline: rgba(15,23,42,0.14);
          --slide-rule:     rgba(71,85,105,0.28);
        }

        /* ── Light mode: engine chrome + Tailwind primitives ─────────────
           Specificity note: the brand pack ships `body.font-sans { background:
           … !important }` and is included AFTER this block, so a bare
           `body.light-mode` loses the tie on document order. Every rule here
           that fights the pack is written `body.light-mode.font-sans`. */
        body.light-mode,
        body.light-mode.font-sans {
          background: #f8fafc !important;
          color: #0f172a !important;
        }
        body.light-mode .slide,
        body.light-mode .vis-slide { background: transparent !important; }
        body.light-mode .text-white     { color: #0f172a !important; }
        body.light-mode .text-slate-200 { color: #1e293b !important; }
        body.light-mode .text-slate-300 { color: #334155 !important; }
        body.light-mode .text-slate-400 { color: #475569 !important; }
        body.light-mode .text-slate-500 { color: #64748b !important; }
        body.light-mode .text-slate-600 { color: #94a3b8 !important; }
        body.light-mode [class*="bg-zenable-bg"] { background-color: #f8fafc !important; }
        body.light-mode [class*="border-slate-7"] { border-color: rgba(15,23,42,0.15) !important; }
        body.light-mode .nav-dot { background: rgba(15,23,42,0.22); }
        body.light-mode .nav-dot::before { background: #1e293b; border-color: rgba(15,23,42,0.2); }
        /* Accent-tinted cards keep their hue in light mode — that tint is how
           a benefit reads as a benefit. Only the neutral surfaces are swapped;
           the coloured fills and borders are left to the brand pack. */
        body.light-mode .slide [class*="bg-slate-"],
        body.light-mode .slide [class*="bg-zenable-bg"] { background-color: #f1f5f9 !important; }
        body.light-mode .gradient-text {
          background: none; -webkit-text-fill-color: initial; color: #0f766e;
        }

        /* ── Light mode: accent text ──────────────────────────────────────
           Every accent in this deck is tuned for a dark ground, which puts it
           around 1.6–2.6:1 on white — legible on a monitor, invisible on a
           projector. Each one is remapped to the same hue several steps
           darker, so identity survives and contrast clears 4.5:1. Fills and
           borders keep the bright value; only TEXT is remapped. */
        body.light-mode .slide .text-teal-400,
        body.light-mode .slide .text-zenable-teal,
        body.light-mode [style*="color:#2dd4bf"],
        body.light-mode [style*="color:#00BAAE"],
        body.light-mode [style*="color:#14E0CC"]   { color: #0f766e !important; }
        body.light-mode .slide .text-emerald-400,
        body.light-mode [style*="color:#4ade80"],
        body.light-mode [style*="color:#34d399"]   { color: #047857 !important; }
        body.light-mode .slide .text-rose-400,
        body.light-mode [style*="color:#fb7185"],
        body.light-mode [style*="color:#f87171"]   { color: #be123c !important; }
        body.light-mode .slide .text-sky-400,
        body.light-mode [style*="color:#60a5fa"],
        body.light-mode [style*="color:#38bdf8"]   { color: #0369a1 !important; }
        body.light-mode .slide .text-purple-400,
        body.light-mode [style*="color:#c084fc"]   { color: #7e22ce !important; }
        body.light-mode .slide .text-amber-400,
        body.light-mode [style*="color:#fbbf24"],
        body.light-mode [style*="color:#fcd34d"]   { color: #b45309 !important; }
        /* Pale fills meant to sit on a dark ground: chip values, soft greens
           and reds. On white these run 1.1–3.1:1, so they take the deep step
           of their own hue. */
        body.light-mode [style*="color:#dbeafe"] { color: #1e3a8a !important; }
        body.light-mode [style*="color:#ffe4e6"] { color: #9f1239 !important; }
        body.light-mode [style*="color:#16a34a"],
        body.light-mode [style*="color:#22c55e"] { color: #15803d !important; }
        body.light-mode [style*="color:#fca5a5"] { color: #b91c1c !important; }

        /* Charts are SVG, so their colours are `fill`/`stroke` attributes and
           none of the text rules above touch them. These are the greys every
           chart in the deck uses for axis labels, ticks and captions.
           Matched on any element, not just <text>: these charts set `fill` on
           a wrapping <g> and let the labels inherit it. */
        body.light-mode .slide svg [fill="#94a3b8"],
        body.light-mode .vis-slide svg [fill="#94a3b8"] { fill: #475569; }
        body.light-mode .slide svg [fill="#cbd5e1"],
        body.light-mode .vis-slide svg [fill="#cbd5e1"] { fill: #334155; }
        body.light-mode .slide svg [fill="#64748b"],
        body.light-mode .vis-slide svg [fill="#64748b"] { fill: #52525b; }
        body.light-mode .slide svg [fill="#5eead4"],
        body.light-mode .vis-slide svg [fill="#5eead4"] { fill: #0f766e; }
        body.light-mode .slide svg [fill="#fcd34d"],
        body.light-mode .vis-slide svg [fill="#fcd34d"] { fill: #a16207; }
        body.light-mode .slide svg [fill="#e2e8f0"],
        body.light-mode .vis-slide svg [fill="#e2e8f0"] { fill: #0f172a; }
        /* Gridlines drawn for a dark ground vanish on white. */
        body.light-mode .slide svg [stroke^="rgba(51,65,85"],
        body.light-mode .vis-slide svg [stroke^="rgba(51,65,85"],
        body.light-mode .slide svg [stroke^="rgba(148,163,184"],
        body.light-mode .vis-slide svg [stroke^="rgba(148,163,184"] { stroke: rgba(71,85,105,0.35); }
        body.light-mode .slide svg rect[fill^="rgba(15,23,42"],
        body.light-mode .vis-slide svg rect[fill^="rgba(15,23,42"] { fill: rgba(241,245,249,0.85); }

        /* Brand-pack kickers and titles use CSS variables rather than hex. */
        body.light-mode .vis-label   { color: #0f766e !important; }
        body.light-mode .unb-label   { color: #0f766e !important; }

        /* ── Code surfaces in light mode ─────────────────────────────────
           The brand pack already turns code cards light and re-tunes its
           syn-* palette for that ground, so the deck follows that rather than
           keeping code dark — one approach, not two. These rules only catch
           the surfaces the pack's substring selectors miss, and carry the
           pack's own specificity (body.light-mode .vis-slide …) so they land
           on the right side of the cascade. */
        body.light-mode [style*="background:rgba(30,41,59,0.85)"] { background: #eef2f7 !important; }
        body.light-mode [style*="background:rgba(30,41,59,0.85)"] .vis-card-filename,
        body.light-mode [style*="background:rgba(30,41,59,0.85)"] > div > span { color: #475569 !important; }

        /* The pack maps a few dark-ground accents to steps that still fall
           short on white (a 3.1:1 green, a 1.8:1 red). Same hue, deeper. */
        body.light-mode.font-sans .vis-slide [style*="color:#4ade80"],
        body.light-mode.font-sans .vis-slide [style*="color:#22c55e"],
        body.light-mode.font-sans .vis-slide [style*="color:#16a34a"] { color: #15803d !important; }
        body.light-mode.font-sans .vis-slide [style*="color:#f87171"],
        body.light-mode.font-sans .vis-slide [style*="color:#fca5a5"] { color: #b91c1c !important; }
        body.light-mode.font-sans .vis-slide [style*="color:#fbbf24"],
        body.light-mode.font-sans .vis-slide [style*="color:#fcd34d"] { color: #a16207 !important; }
        body.light-mode.font-sans .vis-slide [style*="color:#60a5fa"] { color: #0369a1 !important; }
        body.light-mode.font-sans .vis-slide [style*="color:#c084fc"] { color: #7e22ce !important; }
        body.light-mode.font-sans .vis-slide [style*="color:#94a3b8"] { color: #475569 !important; }
        body.light-mode.font-sans .vis-slide [style*="color:#2dd4bf"] { color: #0f766e !important; }
        /* The quoted hook output uses translucent pastels — fine on a dark
           card, 3.1:1 on white. Opaque, deeper, same hue. */
        body.light-mode.font-sans .vis-slide [style*="rgba(134,239,172"] { color: #15803d !important; }
        body.light-mode.font-sans .vis-slide [style*="rgba(248,113,113"] { color: #b91c1c !important; }
        body.light-mode.font-sans .vis-slide [style*="rgba(252,211,77"]  { color: #a16207 !important; }

        /* ── Light / dark toggle ────────────────────────────────────────── */
        .theme-toggle {
          position: fixed; bottom: 20px; right: 20px; z-index: 200;
          width: 44px; height: 44px; border-radius: 50%;
          border: 2px solid rgba(100,116,139,0.3);
          background: rgba(15,23,42,0.85); color: #fbbf24;
          cursor: pointer; font-size: 20px;
          display: flex; align-items: center; justify-content: center;
          transition: transform 0.2s ease, background 0.2s ease;
          backdrop-filter: blur(8px);
          box-shadow: 0 2px 8px rgba(0,0,0,0.3);
        }
        .theme-toggle:hover { transform: scale(1.1); }
        .theme-toggle:focus-visible { outline: 2px solid #2dd4bf; outline-offset: 3px; }
        body.light-mode .theme-toggle {
          background: rgba(255,255,255,0.9);
          border-color: rgba(203,213,225,0.8);
          color: #475569;
          box-shadow: 0 2px 8px rgba(0,0,0,0.12);
        }
        /* Repeated headings that only exist in the PDF, where a swap becomes
           two pages and the second page needs its own title. */
        .print-only { display: none; }
        .nav-dot {
            transition: all 0.3s ease;
            position: relative;
        }
        .nav-dot.active {
            transform: scale(1.5);
            background: #00BAAE;
        }
        .nav-dot::before {
            content: attr(data-label);
            position: absolute;
            right: 20px;
            top: 50%;
            transform: translateY(-50%);
            background: #1D2939;
            color: #fff;
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            white-space: nowrap;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.2s ease;
            border: 1px solid #374151;
        }
        .nav-dot:hover::before {
            opacity: 1;
        }
        .timeline-node {
            transition: all 0.3s ease;
        }
        .timeline-node:hover {
            transform: scale(1.15);
        }
        .timeline-node:hover .timeline-tooltip {
            opacity: 1;
            visibility: visible;
            transform: translateX(-50%) translateY(0);
        }
        .timeline-tooltip {
            opacity: 0;
            visibility: hidden;
            transform: translateX(-50%) translateY(10px);
            transition: all 0.3s ease;
        }
        .gradient-text {
            background: linear-gradient(90deg, #00BAAE, #0071DA);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        /* Filesystem explorer */
        .fs-item { transition: all 0.2s ease; }
        .fs-item:hover, .fs-item-active { background: rgba(0, 186, 174, 0.1); }
        .fs-detail-content.hidden { display: none; }
        /* Hidden slides */
        .hidden-slide {
            display: none !important;
        }
        .show-hidden .hidden-slide {
            display: flex !important;
        }
        .hidden-slide-dot {
            display: none;
        }
        .show-hidden .hidden-slide-dot {
            display: block;
        }

        /* Print / PDF export styles */
        @media print {
            @page {
                /* A real 16:9 page, not letter-landscape. Slides are authored
                   against a 1920x1080 viewport; printing them onto an 11x8.5in
                   sheet (~1056px wide) is a 45% squeeze, which clipped the
                   wider slides off both edges. Matching the page to the
                   authoring viewport makes the PDF a true copy of the deck. */
                size: 1920px 1080px;
                margin: 0;
            }
            html, body {
                height: auto !important;
                overflow: visible !important;
                background: #0B1120 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .scroll-container {
                height: auto !important;
                overflow: visible !important;
                scroll-snap-type: none !important;
            }
            .slide, section.slide {
                min-height: 100vh !important;
                height: 100vh !important;
                page-break-after: always !important;
                break-after: page !important;
                page-break-inside: avoid !important;
                break-inside: avoid !important;
                overflow: hidden !important;
            }
            .slide:last-child {
                page-break-after: auto !important;
                break-after: auto !important;
            }
            /* Hide UI chrome */
            #nav-dots,
            .nav-dot,
            .fixed {
                display: none !important;
            }
            /* Ensure backgrounds print */
            * {
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            /* Disable box shadows — browsers render them as solid blocks in PDF */
            * {
                box-shadow: none !important;
            }
            /* Disable animations */
            .fade-in {
                animation: none !important;
            }
            /* Print every step revealed. For an ADDITIVE slide that is the
               whole story on one page: the final state, everything shown. */
            .step {
                visibility: visible !important;
                animation: none !important;
            }
            /* A SWAP slide is two states in one grid cell, so printing them
               revealed would overlap them. Un-stack it and break between the
               two, so it exports as two pages: the before, then the after. */
            .slide:has(.swap-stack) {
                height: auto !important;
                min-height: 0 !important;
                overflow: visible !important;
                page-break-inside: auto !important;
                break-inside: auto !important;
            }
            .swap-stack { display: block !important; }
            .swap-stack > * { grid-area: auto !important; }
            .swap-out {
                opacity: 1 !important;
                visibility: visible !important;
            }
            .swap-stack > .step {
                page-break-before: always !important;
                break-before: page !important;
            }
            /* Un-stacking drops the section's own vertical centring, which
               left each half pinned to the top of its page with the rest
               blank. Give each half a page-sized box of its own and centre
               inside it, so both printed pages sit like the slide does on
               screen. The first half shares its page with the heading, so it
               gets the smaller box. */
            .swap-out,
            .swap-stack > .step {
                display: flex !important;
                flex-direction: column !important;
                justify-content: center !important;
            }
            /* Sized to what is actually left on each page: the section keeps
               its 48px padding, page one also carries the heading. Too tall
               and the block spills into a blank extra page. */
            .swap-out { min-height: 62vh !important; }
            .swap-stack > .step { min-height: 78vh !important; }
            .print-only { display: block !important; }
            /* Every beat of a focus sequence prints at full strength. */
            .focus-step { opacity: 1 !important; }
            .theme-toggle { display: none !important; }
            /* Autofit scales to the SCREEN viewport, which is not the print
               box — a slide sized to fill 1920x1080 overflows the page and
               gets clipped. Print at the authored size instead. */
            .scroll-container > section > * { zoom: 1 !important; }
            /* Light mode prints on white, not on the dark deck background. */
            body.light-mode { background: #ffffff !important; }
            /* Ensure gradient text prints */
            .gradient-text {
                background: none !important;
                -webkit-background-clip: unset !important;
                background-clip: unset !important;
                -webkit-text-fill-color: #00BAAE !important;
                color: #00BAAE !important;
            }
        }
    </style>
</head>
<body class="font-sans text-slate-200 bg-zenable-bg">
    <!-- Navigation Dots (auto-generated) -->
    <nav class="fixed right-6 top-1/2 -translate-y-1/2 z-50 flex flex-col gap-3" id="nav-dots"></nav>

    <!-- Keyboard hint -->
    <div class="fixed bottom-6 left-6 text-xs text-slate-500 z-50">
        <kbd class="px-2 py-1 bg-zenable-bg-light rounded border border-slate-700">&uarr;</kbd>
        <kbd class="px-2 py-1 bg-zenable-bg-light rounded border border-slate-700">&darr;</kbd>
        or scroll to navigate
    </div>

    <button class="theme-toggle" id="theme-toggle" type="button"
            aria-label="Toggle light and dark mode" title="Toggle light/dark mode">&#9728;&#65039;</button>

    <div class="scroll-container" id="container">
{{ content }}
    </div>

    <script>
        // ── Autofit ──────────────────────────────────────────────────────
        // Slides are authored at a comfortable size for a laptop; on a 1080p
        // projector or a big desktop that leaves half the slide empty. Measure
        // what each slide actually occupies and scale it up to fill the space
        // it has, capped so nothing turns into a billboard. Slides that are
        // already full are left alone — this only ever grows, never shrinks.
        //
        // `zoom` rather than `transform: scale()` so the scaled box still
        // participates in layout and centring keeps working. Applied to the
        // section's children, so the section keeps its own 100vh height.
        (function () {
            var MAX = 1.55;      // never more than this
            var FILL = 0.94;     // leave a little breathing room
            function fit() {
                var slides = document.querySelectorAll('.scroll-container > section');
                slides.forEach(function (s) {
                    var kids = [].filter.call(s.children, function (k) {
                        return k.nodeType === 1 && getComputedStyle(k).position !== 'fixed';
                    });
                    if (!kids.length) return;
                    kids.forEach(function (k) { k.style.zoom = ''; });
                    var cs = getComputedStyle(s);
                    var availH = s.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
                    var availW = s.clientWidth - parseFloat(cs.paddingLeft) - parseFloat(cs.paddingRight);
                    // Measure the INK, not the boxes. Several slides use a
                    // flex:1 spacer that already fills the slide, so measuring
                    // containers would report "full" while the visible content
                    // sits in the middle of an empty column. Leaf elements —
                    // text, images, svg, code — are what actually shows.
                    var top = Infinity, bottom = -Infinity, left = Infinity, right = -Infinity;
                    var LEAFY = { IMG: 1, SVG: 1, PRE: 1, CANVAS: 1, VIDEO: 1, HR: 1, INPUT: 1, BUTTON: 1 };
                    s.querySelectorAll('*').forEach(function (el) {
                        if (!LEAFY[el.tagName] && el.children.length) return;
                        var cs2 = getComputedStyle(el);
                        if (cs2.display === 'none' || cs2.position === 'fixed') return;
                        var r = el.getBoundingClientRect();
                        if (r.height < 1 || r.width < 1) return;
                        top = Math.min(top, r.top); bottom = Math.max(bottom, r.bottom);
                        left = Math.min(left, r.left); right = Math.max(right, r.right);
                    });
                    var h = bottom - top, w = right - left;
                    if (!(h > 0) || !(w > 0)) return;
                    var scale = Math.min(availH * FILL / h, availW * FILL / w, MAX);
                    if (scale > 1.02) {
                        kids.forEach(function (k) { k.style.zoom = scale.toFixed(3); });
                    }
                });
            }
            var pending;
            function schedule() { cancelAnimationFrame(pending); pending = requestAnimationFrame(fit); }
            if (document.fonts && document.fonts.ready) { document.fonts.ready.then(schedule); }
            window.addEventListener('load', schedule);
            window.addEventListener('resize', schedule);
            schedule();
        })();

        // Light / dark toggle. The choice is remembered per browser, so a
        // presenter who set light mode for a bright room gets it back on the
        // next render rather than re-clicking every time.
        (function () {
            var btn = document.getElementById('theme-toggle');
            var SUN = '\u2600\uFE0F', MOON = '\uD83C\uDF19';
            function paint(light) {
                document.body.classList.toggle('light-mode', light);
                btn.textContent = light ? MOON : SUN;
                btn.setAttribute('aria-pressed', light ? 'true' : 'false');
            }
            var saved;
            try { saved = localStorage.getItem('preso-theme'); } catch (e) { saved = null; }
            paint(saved === 'light');
            btn.addEventListener('click', function () {
                var light = !document.body.classList.contains('light-mode');
                paint(light);
                try { localStorage.setItem('preso-theme', light ? 'light' : 'dark'); } catch (e) {}
            });
        })();

        // Auto-generate nav dots from slide sections
        (function() {
            const container = document.getElementById('container');
            const nav = document.getElementById('nav-dots');
            const slides = container.querySelectorAll(':scope > section.slide, :scope > section:not(.slide)');

            // Hide nav dots when there are too many slides to display cleanly
            var visibleCount = 0;
            slides.forEach(function(s) {
                if (!s.classList.contains('hidden-slide')) visibleCount++;
            });
            if (visibleCount > 15) {
                nav.style.display = 'none';
            }

            // Build slide_labels from data-label attributes or fallback to index
            slides.forEach((slide, i) => {
                const label = slide.getAttribute('data-label') || ('Slide ' + i);
                const isHidden = slide.classList.contains('hidden-slide');
                const btn = document.createElement('button');
                btn.className = 'nav-dot w-3 h-3 rounded-full bg-slate-600 hover:bg-zenable-teal' +
                    (i === 0 ? ' active' : '') +
                    (isHidden ? ' hidden-slide-dot' : '');
                btn.setAttribute('data-slide', i);
                btn.setAttribute('data-label', label);
                btn.onclick = function() { goToSlide(i); };
                nav.appendChild(btn);
            });
        })();

        const container = document.getElementById('container');
        const allSlides = container.querySelectorAll(':scope > section.slide, :scope > section:not(.slide)');
        const allDots = document.querySelectorAll('.nav-dot');

        function goToSlide(index, smooth) {
            if (smooth === undefined) smooth = true;
            allSlides[index].scrollIntoView({ behavior: smooth ? 'smooth' : 'auto' });
            updateURL(index);
        }

        function updateURL(index) {
            const url = new URL(window.location);
            url.searchParams.set('slide', index);
            history.replaceState(null, '', url);
        }

        // Update active dot on scroll
        let scrollTimeout;
        container.addEventListener('scroll', function() {
            const scrollPos = container.scrollTop;
            const windowHeight = window.innerHeight;
            const showHidden = document.body.classList.contains('show-hidden');
            let activeIndex = 0;

            allSlides.forEach(function(slide, index) {
                if (!showHidden && slide.classList.contains('hidden-slide')) return;
                if (scrollPos >= slide.offsetTop - windowHeight / 2) {
                    activeIndex = index;
                }
            });

            allDots.forEach(function(d) { d.classList.remove('active'); });
            if (allDots[activeIndex]) allDots[activeIndex].classList.add('active');
            targetSlideIndex = activeIndex;

            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(function() { updateURL(activeIndex); }, 100);
        });

        // Load slide from URL on page load
        var urlParams = new URLSearchParams(window.location.search);
        var startSlide = parseInt(urlParams.get('slide')) || 0;
        if (startSlide > 0 && startSlide < allSlides.length) {
            setTimeout(function() { goToSlide(startSlide, false); }, 50);
        }

        // Keyboard navigation
        var targetSlideIndex = 0;
        var lastNavTime = 0;
        var rapidNavThreshold = 200;

        function getNextVisibleSlide(currentIndex, direction) {
            var showHidden = document.body.classList.contains('show-hidden');
            var newIndex = currentIndex + direction;
            while (newIndex >= 0 && newIndex < allSlides.length) {
                if (showHidden || !allSlides[newIndex].classList.contains('hidden-slide')) {
                    return newIndex;
                }
                newIndex += direction;
            }
            return currentIndex;
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'h' || e.key === 'H') {
                document.body.classList.toggle('show-hidden');
                return;
            }

            var now = Date.now();
            var isRapid = (now - lastNavTime) < rapidNavThreshold;
            lastNavTime = now;

            if (e.key === 'ArrowDown' || e.key === ' ' || e.key === 'PageDown') {
                e.preventDefault();
                // Reveal the next hidden step on this slide before advancing.
                // A step carrying data-step reveals as a GROUP: every step on
                // this slide with the same value appears on one press, so a
                // row of six annotations lands together rather than needing
                // six presses. Steps without the attribute reveal one by one.
                var pending = allSlides[targetSlideIndex].querySelectorAll('.step:not(.step-visible)');
                if (pending.length) {
                    var group = pending[0].getAttribute('data-step');
                    if (group) {
                        allSlides[targetSlideIndex]
                            .querySelectorAll('.step[data-step="' + group + '"]:not(.step-visible)')
                            .forEach(function (el) { el.classList.add('step-visible'); });
                    } else {
                        pending[0].classList.add('step-visible');
                    }
                    return;
                }
                var nextIndex = getNextVisibleSlide(targetSlideIndex, 1);
                if (nextIndex !== targetSlideIndex) {
                    targetSlideIndex = nextIndex;
                    goToSlide(targetSlideIndex, !isRapid);
                }
            } else if (e.key === 'ArrowUp' || e.key === 'PageUp') {
                e.preventDefault();
                // Un-reveal the most recent step on this slide before going
                // back. Grouped steps (data-step) hide together, so stepping
                // backwards undoes exactly what the last press revealed.
                var shown = allSlides[targetSlideIndex].querySelectorAll('.step.step-visible');
                if (shown.length) {
                    var last = shown[shown.length - 1];
                    var lastGroup = last.getAttribute('data-step');
                    if (lastGroup) {
                        allSlides[targetSlideIndex]
                            .querySelectorAll('.step.step-visible[data-step="' + lastGroup + '"]')
                            .forEach(function (el) { el.classList.remove('step-visible'); });
                    } else {
                        last.classList.remove('step-visible');
                    }
                    return;
                }
                var prevIndex = getNextVisibleSlide(targetSlideIndex, -1);
                if (prevIndex !== targetSlideIndex) {
                    targetSlideIndex = prevIndex;
                    goToSlide(targetSlideIndex, !isRapid);
                }
            }
        });
        // Filesystem explorer: click folder to show detail panel
        document.addEventListener('click', function(e) {
            var fsItem = e.target.closest('.fs-item[data-fs-detail]');
            if (!fsItem) return;
            var detailId = fsItem.getAttribute('data-fs-detail');
            var explorer = fsItem.closest('.fs-explorer');
            if (!explorer) return;
            explorer.querySelectorAll('.fs-item').forEach(function(i) { i.classList.remove('fs-item-active'); });
            fsItem.classList.add('fs-item-active');
            explorer.querySelectorAll('.fs-detail-content').forEach(function(d) { d.classList.add('hidden'); });
            var target = explorer.querySelector('[data-fs-detail-id="' + detailId + '"]');
            if (target) target.classList.remove('hidden');
        });
    </script>
    {# Mermaid diagrams: any <pre class="mermaid"> block is rendered in place.
       The library is vendored (modules/shared/js/) so decks work offline;
       the script only loads when the deck actually contains a diagram. #}
    <script>
        if (document.querySelector('.mermaid')) {
            var mermaidStyle = document.createElement('style');
            mermaidStyle.textContent = '.mermaid { display: flex; justify-content: center; } .mermaid svg { max-height: 46vh; height: auto; width: auto; max-width: 100%; }';
            document.head.appendChild(mermaidStyle);
            var mermaidScript = document.createElement('script');
            mermaidScript.src = 'modules/shared/js/mermaid.min.js';
            mermaidScript.onload = function () {
                // Default font family kept: overriding it breaks mermaid's text
                // measurement and labels overflow their boxes.
                mermaid.initialize({
                    startOnLoad: true,
                    theme: 'neutral',
                    themeVariables: {
                        noteBkgColor: '#EDEBE4',
                        noteBorderColor: '#8A8578',
                        noteTextColor: '#1A1A1A',
                        actorBkg: '#FFFFFF',
                        actorBorder: '#1A1A1A',
                        actorTextColor: '#1A1A1A',
                        signalColor: '#1A1A1A',
                        signalTextColor: '#1A1A1A',
                        lineColor: '#1A1A1A'
                    }
                });
            };
            document.body.appendChild(mermaidScript);
        }
    </script>
</body>
</html>
