{#- modules/shared/slides/context-window.j2
    Shared slide content extracted from 2026-06-coding-guardrails.
    Currently emits sans-cloud-flavored HTML (vis-* classes); valid under
    branding="sans-cloud". Future work: replace inline markup with brand-pack
    primitive calls so this content renders under any brand. See AGENTS.md. -#}

{%- macro interactive() -%}
<section class="vis-slide" data-label="Context Window" id="ctx-slide" style="padding-bottom:24px;">
  <div class="vis-label">Context Management</div>
  <div class="vis-title" style="margin-bottom:4px;">How Your Context Window Fills Up</div>
  <div class="vis-subtitle" style="margin-bottom:12px;">Click through each step to see tokens consumed from your 200K context window.</div>
  <div style="flex:1; display:flex; gap:20px; min-height:0;">
    <div style="flex:1; display:flex; flex-direction:column; gap:8px; overflow-y:auto; min-height:0; padding-right:8px;" id="ctx-log">
      <div class="vis-card" style="padding:8px 12px; border-color:rgba(100,116,139,0.4); flex-shrink:0;">
        <p style="font-size:9px; font-weight:600; color:#64748b; text-transform:uppercase; letter-spacing:0.1em; margin:0 0 2px 0;">System Prompt</p>
        <p class="vis-mono" style="font-size:10px; color:#94a3b8; margin:0;">You are Claude Code. You have access to Read, Edit, Bash, Grep...</p>
      </div>
      <div id="ctx-step1" style="display:none; flex-shrink:0;">
        <div style="background:rgba(45,212,191,0.05); border:1px solid rgba(45,212,191,0.3); border-radius:8px; padding:8px 12px;">
          <p style="font-size:9px; font-weight:600; color:#2dd4bf; text-transform:uppercase; letter-spacing:0.1em; margin:0 0 2px 0;">Startup: Loading context files</p>
          <p class="vis-mono" style="font-size:10px; color:#94a3b8; margin:0;">Read AGENTS.md — project rules, architecture constraints, security requirements</p>
        </div>
      </div>
      <div id="ctx-step2" style="display:none; flex-shrink:0;">
        <div style="background:rgba(245,158,11,0.05); border:1px solid rgba(245,158,11,0.3); border-radius:8px; padding:8px 12px;">
          <p style="font-size:9px; font-weight:600; color:#f59e0b; text-transform:uppercase; letter-spacing:0.1em; margin:0 0 4px 0;">Startup: MCP Server — GitHub (24 tools)</p>
          <p class="vis-mono" style="font-size:10px; color:#94a3b8; margin:0 0 4px 0;">Loading tool schemas into system prompt...</p>
          <div style="display:flex; gap:3px; flex-wrap:wrap;">
            <span class="vis-tool-tag" style="background:rgba(245,158,11,0.1); color:#fcd34d; font-size:8px;">create_pr()</span>
            <span class="vis-tool-tag" style="background:rgba(245,158,11,0.1); color:#fcd34d; font-size:8px;">list_issues()</span>
            <span class="vis-tool-tag" style="background:rgba(245,158,11,0.1); color:#fcd34d; font-size:8px;">get_repo()</span>
            <span class="vis-tool-tag" style="background:rgba(245,158,11,0.1); color:#fcd34d; font-size:8px;">search_code()</span>
            <span class="vis-tool-tag" style="background:rgba(245,158,11,0.1); color:#fcd34d; font-size:8px;">+ 20 more</span>
          </div>
        </div>
      </div>
      <div id="ctx-step3" style="display:none; flex-shrink:0;">
        <div style="background:rgba(30,41,59,0.6); border-radius:8px; padding:8px 12px; border-left:2px solid rgba(96,165,250,0.6);">
          <p style="font-size:9px; color:#60a5fa; font-weight:600; margin:0 0 2px 0;">You</p>
          <p class="vis-mono" style="font-size:11px; color:#e2e8f0; margin:0;">Fix the SQL injection vulnerability in our auth service</p>
        </div>
      </div>
      <div id="ctx-step4" style="display:none; flex-shrink:0;">
        <div style="background:rgba(30,41,59,0.6); border-radius:8px; padding:8px 12px; border-left:2px solid rgba(168,85,247,0.6);">
          <p style="font-size:9px; color:#c084fc; font-weight:600; margin:0 0 2px 0;">Claude</p>
          <p class="vis-mono" style="font-size:10px; color:#cbd5e1; margin:0 0 4px 0;">I'll read the auth service to find the vulnerability.</p>
          <div style="background:rgba(15,23,42,0.6); border:1px solid rgba(51,65,85,0.5); border-radius:4px; padding:4px 8px; display:inline-flex; align-items:center; gap:6px;">
            <span class="vis-mono" style="font-size:10px; color:#2dd4bf;">Read</span>
            <span class="vis-mono" style="font-size:10px; color:#94a3b8;">src/auth_service.py</span>
          </div>
        </div>
      </div>
      <div id="ctx-step5" style="display:none; flex-shrink:0;">
        <div style="background:rgba(30,41,59,0.4); border-radius:8px; padding:8px 12px; border:1px solid rgba(51,65,85,0.3);">
          <p style="font-size:9px; color:#64748b; font-weight:600; margin:0 0 2px 0;">Tool Result — 847 tokens</p>
          <p class="vis-mono" style="font-size:9px; color:#94a3b8; margin:0; white-space:nowrap; overflow:hidden; text-overflow:ellipsis;"><span class="syn-type">def</span> <span class="syn-id">login</span>(req): user = db.query(<span class="syn-str">f"SELECT * FROM users WHERE email='{req.email}'"</span>)...</p>
        </div>
      </div>
      <div id="ctx-step6" style="display:none; flex-shrink:0;">
        <div style="background:rgba(30,41,59,0.4); border-radius:8px; padding:8px 12px; border:1px solid rgba(51,65,85,0.3);">
          <p style="font-size:9px; color:#64748b; font-weight:600; margin:0 0 2px 0;">Read models.py — 1,240 tokens</p>
          <p class="vis-mono" style="font-size:9px; color:#94a3b8; margin:0;">class User(Base): email = Column(String), password_hash = Column(String)...</p>
        </div>
      </div>
    </div>
    <div style="width:300px; flex-shrink:0; display:flex; flex-direction:column; gap:10px;">
      <p style="font-size:10px; font-weight:600; text-transform:uppercase; letter-spacing:0.15em; color:#64748b; margin:0;">200K Token Context Window</p>
      <style>
        .ctx-seg { width:100%; transition:height 0.6s ease; position:relative; cursor:default; overflow:hidden; }
        .ctx-seg .ctx-lbl { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; font-size:10px; font-weight:600; font-family:'Fira Mono',monospace; opacity:0; transition:opacity 0.2s; pointer-events:none; }
        .ctx-seg:hover .ctx-lbl { opacity:1; }
      </style>
      <div class="vis-bar-track" style="height:320px; flex-direction:column; border-radius:12px;">
        <div id="ctx-bar-system" class="ctx-seg" style="height:5%; background:rgba(100,116,139,0.4); border-bottom:1px solid rgba(100,116,139,0.3);"><span class="ctx-lbl" style="color:#94a3b8;" id="ctx-pct-sys">System 5%</span></div>
        <div id="ctx-bar-ctx" class="ctx-seg" style="height:0%; background:rgba(34,197,94,0.4); border-bottom:1px solid rgba(34,197,94,0.3);"><span class="ctx-lbl" style="color:#4ade80;" id="ctx-pct-ctx"></span></div>
        <div id="ctx-bar-mcp" class="ctx-seg" style="height:0%; background:rgba(245,158,11,0.4); border-bottom:1px solid rgba(245,158,11,0.3);"><span class="ctx-lbl" style="color:#fcd34d;" id="ctx-pct-mcp"></span></div>
        <div id="ctx-bar-prompt" class="ctx-seg" style="height:0%; background:rgba(96,165,250,0.4); border-bottom:1px solid rgba(96,165,250,0.3);"><span class="ctx-lbl" style="color:#93c5fd;" id="ctx-pct-prompt"></span></div>
        <div id="ctx-bar-files" class="ctx-seg" style="height:0%; background:rgba(45,212,191,0.4);"><span class="ctx-lbl" style="color:#5eead4;" id="ctx-pct-files"></span></div>
      </div>
      <div class="vis-card" style="padding:8px; text-align:center;">
        <p style="font-size:10px; color:#64748b; margin:0 0 2px 0;">Tokens used</p>
        <p style="font-size:24px; font-weight:700; color:#e2e8f0; margin:0; font-family:'Fira Mono',monospace;" id="ctx-counter">10,000</p>
        <p style="font-size:10px; color:#64748b; margin:2px 0 0 0;">of 200,000</p>
      </div>
      <div style="display:flex; gap:8px;">
        <button id="ctx-next-btn" onclick="ctxNext()" style="flex:1; background:var(--sans-orange); color:#fff; border:none; border-radius:8px; padding:10px 20px; font-size:13px; font-weight:700; cursor:pointer; font-family:'Fira Sans',sans-serif;">
          Start Session ▶
        </button>
        <button id="ctx-reset-btn" onclick="ctxReset()" style="background:transparent; color:#94a3b8; border:1px solid rgba(148,163,184,0.4); border-radius:8px; padding:10px 16px; font-size:13px; font-weight:600; cursor:pointer; font-family:'Fira Sans',sans-serif;">
          ↺ Reset
        </button>
      </div>
    </div>
  </div>
  <script>
  (function(){
    var step = 0;
    var steps = [
      ['ctx-step1', 3,  0,  0, 0, 16000,  'Connect MCP Server ▶'],
      ['ctx-step2', 3,  33, 0, 0, 76000,  'Send Prompt ▶'],
      ['ctx-step3', 3,  33, 2, 0, 78400,  'Allow Read ▶'],
      ['ctx-step4', 3,  33, 3, 0, 80200,  'Allow ▶'],
      ['ctx-step5', 3,  33, 3, 4, 88000,  'Allow Read ▶'],
      ['ctx-step6', 3,  33, 3, 10,100200, ''],
    ];
    window.ctxNext = function(){
      if(step >= steps.length) return;
      var s = steps[step];
      document.getElementById(s[0]).style.display = 'block';
      var log = document.getElementById('ctx-log');
      setTimeout(function(){ log.scrollTop = log.scrollHeight; }, 50);
      document.getElementById('ctx-bar-ctx').style.height = s[1]+'%';
      document.getElementById('ctx-bar-mcp').style.height = s[2]+'%';
      document.getElementById('ctx-bar-prompt').style.height = s[3]+'%';
      document.getElementById('ctx-bar-files').style.height = s[4]+'%';
      document.getElementById('ctx-counter').textContent = s[5].toLocaleString();
      if(s[1]>0) document.getElementById('ctx-pct-ctx').textContent = 'Context files '+s[1]+'%';
      if(s[2]>0) document.getElementById('ctx-pct-mcp').textContent = 'MCP schemas '+s[2]+'%';
      if(s[3]>0) document.getElementById('ctx-pct-prompt').textContent = 'Conversation '+s[3]+'%';
      if(s[4]>0) document.getElementById('ctx-pct-files').textContent = 'File reads '+s[4]+'%';
      step++;
      if(step < steps.length){
        document.getElementById('ctx-next-btn').textContent = steps[step-1][6];
      } else {
        document.getElementById('ctx-next-btn').style.display = 'none';
      }
    };
    window.ctxReset = function(){
      step = 0;
      for(var i = 0; i < steps.length; i++){
        var el = document.getElementById(steps[i][0]);
        if(el) el.style.display = 'none';
      }
      document.getElementById('ctx-bar-ctx').style.height = '0%';
      document.getElementById('ctx-bar-mcp').style.height = '0%';
      document.getElementById('ctx-bar-prompt').style.height = '0%';
      document.getElementById('ctx-bar-files').style.height = '0%';
      document.getElementById('ctx-pct-ctx').textContent = '';
      document.getElementById('ctx-pct-mcp').textContent = '';
      document.getElementById('ctx-pct-prompt').textContent = '';
      document.getElementById('ctx-pct-files').textContent = '';
      document.getElementById('ctx-counter').textContent = (10000).toLocaleString();
      var btn = document.getElementById('ctx-next-btn');
      btn.style.display = '';
      btn.textContent = 'Start Session ▶';
      document.getElementById('ctx-log').scrollTop = 0;
    };
  })();
  </script>
</section>

{%- endmacro -%}
