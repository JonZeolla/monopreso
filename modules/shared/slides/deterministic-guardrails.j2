{#- modules/shared/slides/deterministic-guardrails.j2
    Shared slide content extracted from 2026-06-coding-guardrails.
    Currently emits sans-cloud-flavored HTML (vis-* classes); valid under
    branding="sans-cloud". Future work: replace inline markup with brand-pack
    primitive calls so this content renders under any brand. See AGENTS.md. -#}

{%- macro pci_example() -%}
<section class="vis-slide" data-label="Guardrails">
  <div class="vis-label">Policy-as-Code</div>
  <div class="vis-title">Deterministic Guardrails</div>
  <div style="flex:1;">
    <div class="vis-card">
      <div class="vis-card-header">
        <div class="vis-card-dots"><span class="dot-red"></span><span class="dot-yellow"></span><span class="dot-green"></span></div>
        <span class="vis-card-filename">payment_handler.py</span>
        <span style="margin-left:auto; font-size:11px; color:#94a3b8; font-weight:600;">Agent Chat</span>
      </div>
      <div style="padding:16px; display:flex; flex-direction:column; gap:14px;">
        <div style="background:rgba(30,41,59,0.4); border-radius:8px; padding:14px; border:1px solid rgba(51,65,85,0.3);">
          <div style="background:#11111b; border-radius:6px; padding:10px;" class="vis-mono vis-code" style="font-size:12px; line-height:1.7;">
            <p style="margin:0;">&nbsp;&nbsp;&nbsp;&nbsp;log.info(<span class="syn-str">f"Charging ${amount} to card {card}, cvv {cvv}"</span>)</p>
            <p style="margin:0;">&nbsp;&nbsp;&nbsp;&nbsp;db.execute(<span class="syn-str">f"INSERT INTO payments VALUES ('{card}', {amount})"</span>)</p>
          </div>
        </div>
        <div style="background:rgba(127,29,29,0.3); border-radius:8px; padding:14px; border:1px solid rgba(239,68,68,0.3);">
          <div style="display:flex; align-items:center; gap:8px; margin-bottom:6px;">
            <span style="font-size:14px;">⚠️</span>
            <span style="font-size:12px; font-weight:700; color:#f87171;">Guardrail Violation</span>
          </div>
          <p class="vis-mono" style="font-size:11px; color:rgba(248,113,113,0.8); margin:0;">Policy <span style="color:#f87171; font-weight:600;">pci-dss/no-pan-logging</span>: Logging raw card number and CVV violates PCI-DSS §3.4. SQL string interpolation violates <span style="color:#f87171; font-weight:600;">sql-injection/no-interpolation</span>.</p>
        </div>
        <div style="background:rgba(30,41,59,0.4); border-radius:8px; padding:14px; border:1px solid rgba(51,65,85,0.3);">
          <p style="font-size:12px; color:#c084fc; font-weight:600; margin:0 0 8px 0;">Claude</p>
          <p style="font-size:12px; color:#94a3b8; margin:0 0 10px 0;">Good catch. Masking the PAN, removing CVV from logs, and switching to parameterized queries:</p>
          <div style="background:#11111b; border-radius:6px; padding:10px;" class="vis-mono vis-code">
            <p style="margin:0; color:#f87171; background:rgba(239,68,68,0.1); padding:2px 6px; border-radius:4px;"><span style="user-select:none;">- </span>log.info(f"Charging ${amount} to card {card}, cvv {cvv}")</p>
            <p style="margin:0; color:#4ade80; background:rgba(34,197,94,0.1); padding:2px 6px; border-radius:4px;"><span style="user-select:none;">+ </span>log.info(f"Charging ${amount} to card ****{card[-4:]}")</p>
            <p style="margin:0;">&nbsp;</p>
            <p style="margin:0; color:#f87171; background:rgba(239,68,68,0.1); padding:2px 6px; border-radius:4px;"><span style="user-select:none;">- </span>db.execute(f"INSERT INTO payments VALUES ('{card}', {amount})")</p>
            <p style="margin:0; color:#4ade80; background:rgba(34,197,94,0.1); padding:2px 6px; border-radius:4px;"><span style="user-select:none;">+ </span>db.execute("INSERT INTO payments VALUES (%s, %s)", (masked, amount))</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{%- endmacro -%}
