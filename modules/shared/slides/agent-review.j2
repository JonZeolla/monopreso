        <p class="vis-mono" style="font-size:11px; color:#cbd5e1; background:rgba(30,41,59,0.6); border-radius:6px; padding:8px; border-left:2px solid rgba(248,113,113,0.6); margin:0;">"SQL injection on L6-7. Use parameterized queries. Hash passwords, never compare plaintext."</p>
      </div>
      <div style="border-radius:12px; border:1px solid rgba(251,191,36,0.3); background:rgba(15,23,42,0.95); padding:14px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
          <div style="width:24px;height:24px;border-radius:8px;background:rgba(251,191,36,0.2);border:1px solid rgba(251,191,36,0.3);display:flex;align-items:center;justify-content:center;">
