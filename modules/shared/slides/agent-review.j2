            <p style="margin:0;"><span style="color:#475569; margin-right:8px;"> 8</span>&nbsp;&nbsp;)</p>
            <p style="margin:0; background:rgba(251,191,36,0.06);"><span style="color:#475569; margin-right:8px;"> 9</span>&nbsp;&nbsp;<span class="syn-type">if</span> user.password == request.pw:</p>
