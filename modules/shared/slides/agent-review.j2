            <p style="margin:0;"><span style="color:#475569; margin-right:8px;">11</span>&nbsp;&nbsp;&nbsp;&nbsp;<span class="syn-type">return</span> {<span class="syn-str">"token"</span>: token}</p>
            <p style="margin:0;"><span style="color:#475569; margin-right:8px;">12</span>&nbsp;&nbsp;<span class="syn-type">return</span> {<span class="syn-str">"error"</span>: <span class="syn-str">"fail"</span>}</p>
