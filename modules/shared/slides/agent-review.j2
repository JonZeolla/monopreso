        <p class="vis-mono" style="font-size:11px; color:#cbd5e1; background:rgba(30,41,59,0.6); border-radius:6px; padding:8px; border-left:2px solid rgba(251,191,36,0.6); margin:0;">"No tests. Missing error handling for null user. Generic error message leaks nothing, good."</p>
      </div>
      <div style="border-radius:12px; border:1px solid rgba(96,165,250,0.3); background:rgba(15,23,42,0.95); padding:14px;">
        <div style="display:flex; align-items:center; gap:8px; margin-bottom:8px;">
