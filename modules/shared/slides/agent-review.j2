      <svg width="28" height="28" viewBox="0 0 24 24" style="color:#fbbf24;transform:rotate(180deg);"><path d="M5 12h14m-7-7l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      <svg width="28" height="28" viewBox="0 0 24 24" style="color:#60a5fa;transform:rotate(180deg);"><path d="M5 12h14m-7-7l7 7-7 7" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
