{#- modules/context/context-layers.j2
    Three slides ported from the Zenable "Foundation, part 1" lab deck
    (next-gen-governance: services/ui_frontend/src/lib/labs/content/slides/
    foundation-part-1.tsx — ContextLayersSlide, ScopeFilterSlide — and
    shared/same-context-two-models.tsx). Text is carried over verbatim; the
    geometry is the source's SVG with its hex colours swapped for slide and
    accent tokens so it renders in any pack and in light mode.

      layers()             "Context layers in": company → you stack, arrow, a
                           model wrapped in hooks / conformance checks /
                           agentic reviews.
      scope_filter()       "Not all context applies": eleven pieces of context
                           through a scope funnel, six reach the task.
      same_context_two_models()  one AGENTS.md line, two models, two outcomes.

    Primitive-native. Import WITH CONTEXT.
      {%- from "modules/context/context-layers.j2" import layers, scope_filter, same_context_two_models with context %}
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import content_slide, slide_heading -%}

{%- macro layers() -%}
{%- call content_slide("Context layers in") %}
<style>
  .cl svg { width: 100%; height: auto; margin-top: 1rem; font-family: inherit; }
  .cl .box { fill: var(--slide-surface); stroke: var(--slide-rule); stroke-width: 2; }
  .cl .box.alt { fill: var(--slide-sunken); }
  .cl .name { font-size: 26px; font-weight: 700; fill: var(--slide-ink); }
  .cl .ex { font-size: 17px; fill: var(--slide-ink-3); }
  .cl .arrow { stroke: var(--slide-rule); stroke-width: 2.5; fill: none; }
  .cl .head { fill: var(--slide-rule); }
  .cl .shell { fill: var(--slide-sunken); stroke: var(--accent-primary); stroke-width: 3; }
  .cl .seg { fill: var(--slide-surface); stroke: var(--slide-rule); stroke-width: 2; }
  .cl .seg-t { font-size: 18px; font-weight: 600; fill: var(--slide-ink); text-anchor: middle; }
  .cl .core { fill: color-mix(in srgb, var(--accent-primary) 14%, var(--slide-sunken)); stroke: var(--accent-primary); stroke-width: 2; }
  .cl .model { font-size: 26px; font-weight: 700; fill: var(--slide-ink); text-anchor: middle; }
  .cl .kicker { font-size: 14px; font-weight: 600; letter-spacing: .12em; fill: var(--accent-primary); text-anchor: middle; }
</style>
{{ slide_heading("", "Context layers in") }}
<div class="cl">
<svg viewBox="0 0 1380 500" role="img"
     aria-label="Context from the company, product line, team, repository and you layers into a coding agent: a model wrapped in hooks, conformance checks and agentic reviews.">
  {%- for name, ex in [
    ("Company", "Security requirements &middot; Approved libraries"),
    ("Product line", "Payments domain docs (MCP) &middot; PCI rules"),
    ("Team", "Review conventions &middot; Team runbooks (MCP)"),
    ("Repository", "AGENTS.md &middot; Skills &middot; Code"),
    ("You", "Memory &middot; Personal preferences"),
  ] %}
  {%- set i = loop.index0 %}
  <rect class="box{% if i % 2 %} alt{% endif %}" x="{{ i * 25 }}" y="{{ i * 100 }}" width="{{ 680 - i * 45 }}" height="84" rx="14"/>
  <text class="name" x="{{ i * 25 + 28 }}" y="{{ i * 100 + 36 }}">{{ name }}</text>
  <text class="ex" x="{{ i * 25 + 28 }}" y="{{ i * 100 + 66 }}">{{ ex }}</text>
  {%- endfor %}
  <path class="arrow" d="M705,260 L842,260"/><path class="head" d="M840,253 L854,260 L840,267 Z"/>
  <circle class="shell" cx="1090" cy="260" r="225"/>
  {#- Ring segments: inner 120, outer 222, 114° each starting at -87°, 33°, 153°. -#}
  <path class="seg" d="M1101.6,38.3 A222,222 0 0 1 1287.8,360.8 L1196.9,314.5 A120,120 0 0 0 1096.3,140.2 Z"/>
  <text class="seg-t" x="1238.1" y="180.5">Hooks</text>
  <path class="seg" d="M1276.2,380.9 A222,222 0 0 1 903.8,380.9 L989.4,325.4 A120,120 0 0 0 1190.6,325.4 Z"/>
  <text class="seg-t" x="1090" y="426">Conformance</text><text class="seg-t" x="1090" y="448">checks</text>
  <path class="seg" d="M892.2,360.8 A222,222 0 0 1 1078.4,38.3 L1083.7,140.2 A120,120 0 0 0 983.1,314.5 Z"/>
  <text class="seg-t" x="941.9" y="169.5">Agentic</text><text class="seg-t" x="941.9" y="191.5">reviews</text>
  <circle class="core" cx="1090" cy="260" r="112"/>
  <text class="model" x="1090" y="252">Model</text>
  <text class="kicker" x="1090" y="282">CODING AGENT</text>
</svg>
</div>
{%- endcall %}
{%- endmacro -%}


{%- macro scope_filter() -%}
{%- call content_slide("Not all context applies") %}
<style>
  .sf svg { width: 100%; height: auto; margin-top: .5rem; font-family: inherit; }
  .sf .lbl { font-size: 15px; font-weight: 600; letter-spacing: .12em; fill: var(--slide-ink-3); }
  .sf .chip { fill: var(--slide-surface); stroke: var(--accent-primary); stroke-width: 2; }
  .sf .chip-t { font-size: 17px; font-weight: 500; fill: var(--slide-ink); text-anchor: middle; }
  .sf .funnel { fill: var(--slide-sunken); stroke: var(--slide-rule); stroke-width: 2; }
  .sf .scope { fill: var(--slide-sunken); stroke: var(--accent-primary); stroke-width: 2; }
  .sf .scope-t { font-size: 26px; font-weight: 700; fill: var(--slide-ink); text-anchor: middle; }
  .sf .scope-s { font-size: 16px; fill: var(--slide-ink-3); text-anchor: middle; }
  .sf .arrow { stroke: var(--slide-rule); stroke-width: 2; fill: none; }
  .sf .head { fill: var(--slide-rule); }
</style>
{{ slide_heading("", "Not all context applies") }}
<div class="sf">
{%- set all = ["Security requirements", "Approved libraries", "PCI rules", "Mobile app guidelines",
               "Review conventions", "Go style guide", "AGENTS.md", "frontend/AGENTS.md",
               "Deploy skill", "Memory", "Old project notes"] %}
{%- set kept = ["Security requirements", "Approved libraries", "PCI rules", "Review conventions", "AGENTS.md", "Memory"] %}
<svg viewBox="-2 -2 1404 644" role="img"
     aria-label="Eleven pieces of context pass through a scope filter, and six reach the task.">
  <text class="lbl" x="0" y="15">EVERYTHING THAT EXISTS</text>
  <text class="lbl" x="1070" y="15">WHAT THIS TASK GETS</text>
  {%- for label in all %}
  <rect class="chip" x="0" y="{{ 25 + loop.index0 * 54 }}" width="330" height="40" rx="20"/>
  <text class="chip-t" x="165" y="{{ 51 + loop.index0 * 54 }}">{{ label }}</text>
  {%- endfor %}
  <path class="funnel" d="M360,25 L360,615 L650,405 L650,235 Z"/>
  <rect class="scope" x="650" y="235" width="300" height="170" rx="16"/>
  <text class="scope-t" x="800" y="305">Scope</text>
  <text class="scope-s" x="800" y="341">language &middot; folder &middot; team</text>
  <text class="scope-s" x="800" y="369">product &middot; task</text>
  <path class="arrow" d="M955,320 L1052,320"/><path class="head" d="M1050,314 L1062,320 L1050,326 Z"/>
  {%- for label in kept %}
  <rect class="chip" x="1070" y="{{ 165 + loop.index0 * 54 }}" width="330" height="40" rx="20"/>
  <text class="chip-t" x="1235" y="{{ 191 + loop.index0 * 54 }}">{{ label }}</text>
  {%- endfor %}
</svg>
</div>
{%- endcall %}
{%- endmacro -%}


{%- macro same_context_two_models() -%}
{%- call content_slide("Same context, two models") %}
<style>
  .sc { margin-top: 1rem; }
  .sc .line { border: 1px solid var(--slide-hairline); background: var(--slide-surface); border-radius: 1rem; padding: 1rem 1.25rem; margin-bottom: 1.25rem; }
  .sc .line small { display: block; font-size: .7rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--slide-ink-3); margin-bottom: .4rem; }
  .sc .line code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 1rem; color: var(--slide-ink); }
  .sc .two { display: grid; grid-template-columns: 1fr auto 1fr; gap: 2.5rem; }
  .sc .rule { border-left: 2px dashed var(--slide-rule); }
  .sc .model { border: 1px solid var(--slide-hairline); background: var(--slide-surface); border-radius: 1rem; padding: 1.25rem; }
  .sc .model h4 { margin: 0; font-size: 1.4rem; font-weight: 700; color: var(--slide-ink); }
  .sc .cols { display: flex; justify-content: space-between; font-size: .7rem; color: var(--slide-ink-3); margin: .25rem 0 .75rem; }
  .sc .thread { display: flex; flex-direction: column; gap: .5rem; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .95rem; }
  .sc .w { align-self: flex-start; border: 1px solid var(--accent-primary); background: color-mix(in srgb, var(--accent-primary) 10%, transparent);
           border-radius: 1rem 1rem 1rem .25rem; padding: .35rem 1rem; color: var(--slide-ink); }
  .sc .c { align-self: flex-end; border: 1px solid var(--slide-rule); background: var(--slide-sunken);
           border-radius: 1rem 1rem .25rem 1rem; padding: .35rem 1rem; color: var(--slide-ink-2); }
  .sc .m { align-self: flex-end; padding: 0 1rem; color: var(--slide-ink-3); }
  .sc .verdict { margin: 1rem 0 0; font-size: 1.05rem; font-weight: 600; }
  .sc .ok { color: var(--accent-primary); } .sc .warn { color: var(--accent-warning); }
</style>
{{ slide_heading("", "Same context, two models") }}
<div class="sc">
  <div class="line"><small>Same AGENTS.md line</small>
    <code>Use the Zenable CLI to do a conformance check after every time you write a file. Use it as much as possible, don't worry it's not expensive</code></div>
  <div class="two">
    <div class="model"><h4>Model A</h4><div class="cols"><span>agent writes</span><span>check replies</span></div>
      <div class="thread">
        <span class="w">&#9998; wrote src/api.py</span><span class="c">src/api.py &middot; 0 findings &#10003;</span>
        <span class="w">&#9998; wrote src/models.py</span><span class="c">src/models.py &middot; 0 findings &#10003;</span>
        <span class="w">&#9998; wrote tests/test_api.py</span><span class="c">tests/test_api.py &middot; 0 findings &#10003;</span>
        <span class="w">&#9998; done</span>
      </div>
      <p class="verdict ok">Checks each file once, then moves on</p></div>
    <div class="rule" aria-hidden="true"></div>
    <div class="model"><h4>Model B</h4><div class="cols"><span>agent writes</span><span>check replies</span></div>
      <div class="thread">
        <span class="w">&#9998; wrote src/api.py</span>
        {%- for _ in range(5) %}<span class="c">src/api.py &middot; 0 findings &#10003;</span>{% endfor %}
        <span class="m">&hellip;</span>
      </div>
      <p class="verdict warn">Checks the same file forever</p></div>
  </div>
</div>
{%- endcall %}
{%- endmacro -%}
