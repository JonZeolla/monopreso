{#- modules/ci-cd/cicd-enforcement.j2
    Shared slide content extracted from 2026-06-coding-guardrails.
    Currently emits sans-cloud-flavored HTML (vis-* classes); valid under
    branding="sans-cloud". Future work: replace inline markup with brand-pack
    primitive calls so this content renders under any brand. See AGENTS.md. -#}

{%- macro enforcement_window() -%}
<section class="vis-slide" data-label="CI/CD Enforcement">
  <div class="vis-label">Where guardrails fire</div>
  <div class="vis-title">CI/CD is your enforcement window</div>
  <div class="vis-subtitle">Every change — human or AI — flows through this gate.</div>

  <div style="flex:1; display:flex; align-items:stretch; gap:14px; padding:24px 0;">

    <div style="flex:0 0 auto; align-self:center; opacity:0.55; text-align:center; width:90px;">
      <p style="font-size:11px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#94a3b8; margin:0 0 6px 0;">Author</p>
      <p style="font-size:12px; color:#64748b; margin:0;">human or AI</p>
    </div>
    <div style="align-self:center; color:#475569; font-size:24px;">→</div>

    <div style="flex:0 0 auto; align-self:center; opacity:0.55; text-align:center; width:90px;">
      <p style="font-size:11px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#94a3b8; margin:0 0 6px 0;">Commit</p>
      <p style="font-size:12px; color:#64748b; margin:0;">push branch</p>
    </div>
    <div style="align-self:center; color:#475569; font-size:24px;">→</div>

    <div style="flex:1; background:rgba(45,212,191,0.06); border:2px solid rgba(45,212,191,0.45); border-radius:16px; padding:22px;">
      <div style="text-align:center; margin-bottom:18px;">
        <p style="font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#2dd4bf; margin:0 0 4px 0;">CI / Merge Request</p>
        <p style="font-size:14px; color:#cbd5e1; margin:0; font-style:italic;">the enforcement window</p>
      </div>
      <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:10px;">
        <div class="vis-teal-card" style="padding:14px; text-align:center;">
          <p style="font-size:14px; font-weight:700; color:#5eead4; margin:0;">Linters</p>
          <p style="font-size:10px; color:#94a3b8; margin:4px 0 0 0;">style, obvious bugs</p>
        </div>
        <div class="vis-blue-card" style="padding:14px; text-align:center;">
          <p style="font-size:14px; font-weight:700; color:#93c5fd; margin:0;">SAST</p>
          <p style="font-size:10px; color:#94a3b8; margin:4px 0 0 0;">known patterns</p>
        </div>
        <div class="vis-purple-card" style="padding:14px; text-align:center;">
          <p style="font-size:14px; font-weight:700; color:#d8b4fe; margin:0;">Policy as Code</p>
          <p style="font-size:10px; color:#94a3b8; margin:4px 0 0 0;">org rules</p>
        </div>
        <div class="vis-amber-card" style="padding:14px; text-align:center;">
          <p style="font-size:14px; font-weight:700; color:#fcd34d; margin:0;">Tests</p>
          <p style="font-size:10px; color:#94a3b8; margin:4px 0 0 0;">unit, integration</p>
        </div>
        <div class="vis-green-card" style="padding:14px; text-align:center;">
          <p style="font-size:14px; font-weight:700; color:#86efac; margin:0;">AI Review</p>
          <p style="font-size:10px; color:#94a3b8; margin:4px 0 0 0;">contextual analysis</p>
        </div>
        <div class="vis-red-card" style="padding:14px; text-align:center;">
          <p style="font-size:14px; font-weight:700; color:rgba(248,113,113,0.9); margin:0;">Approvals</p>
          <p style="font-size:10px; color:#94a3b8; margin:4px 0 0 0;">human judgment</p>
        </div>
      </div>
    </div>

    <div style="align-self:center; color:#475569; font-size:24px;">→</div>

    <div style="flex:0 0 auto; align-self:center; opacity:0.55; text-align:center; width:100px;">
      <p style="font-size:11px; font-weight:700; letter-spacing:0.15em; text-transform:uppercase; color:#94a3b8; margin:0 0 6px 0;">Merge<br>&amp; Deploy</p>
      <p style="font-size:12px; color:#64748b; margin:0;">prod</p>
    </div>
  </div>

  <div class="vis-callout vis-callout-teal" style="text-align:center;">
    <span style="font-weight:600;">AI accelerates input.</span> CI is where you keep up.
  </div>
</section>
{%- endmacro -%}
