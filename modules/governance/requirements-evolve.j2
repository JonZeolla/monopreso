{#- modules/governance/requirements-evolve.j2
    Requirements evolve: the nine events that should change a requirement,
    and the reminder that each one should update every level of the stack.

    Ported from the AI-Native lab deck (services/ui_frontend
    slides/ai-native.tsx, "Requirements Evolve"), copy unchanged.

    Written against the brand-pack primitive contract (see AGENTS.md): no hex
    colors, no brand class names. Import WITH CONTEXT:

      {%- from "modules/governance/requirements-evolve.j2" import
          triggers with context %}
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import
    content_slide,
    slide_heading,
    card_grid,
    callout
-%}


{%- macro triggers() -%}
{%- call content_slide("Requirements evolve") %}
  {{ slide_heading("", "Requirements Evolve") }}
  {{ card_grid([
    {"title": "Recent Incident",
     "body": "Identify new requirements from a breach, near-miss, or audit finding",
     "accent": "danger"},
    {"title": "New Contract",
     "body": "Pull in requirements from a customer agreement or regulatory mandate",
     "accent": "warning"},
    {"title": "Risk Assessment",
     "body": "Draft a new requirement from a risk rated unacceptable",
     "accent": "secondary"},
    {"title": "Refine Scope",
     "body": "Increase, decrease, or split a requirement with different scopes",
     "accent": "primary"},
    {"title": "New Threat",
     "body": "Add guardrails before a new threat becomes an incident",
     "accent": "info"},
    {"title": "Add Exception",
     "body": "Documented exception with compensating controls",
     "accent": "neutral"},
    {"title": "New Data Type",
     "body": "Sensitive data you didn't handle before that changes your risk profile",
     "accent": "warning"},
    {"title": "Regulatory Update",
     "body": "New law or standard (EU AI Act, PCI DSS 4.0, state privacy law)",
     "accent": "danger"},
    {"title": "Technology Change",
     "body": "New framework, language, or runtime that existing guardrails don't cover",
     "accent": "info"},
  ], cols=3) }}
  {{ callout("<strong>Use these events to improve every level.</strong> Update context
              foundations, pull new context into reviewing agents, author new
              deterministic guardrails. Then roll them all out to every developer.",
             accent="primary") }}
{%- endcall %}
{%- endmacro -%}
