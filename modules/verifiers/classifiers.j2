{#- modules/verifiers/classifiers.j2
    The machine-learning verifier, applied to agent behaviour: classifiers
    label each action, clustering groups sessions without labels, and a
    pipeline turns both into alerts and rule changes.

    Written against the brand-pack primitive contract (see AGENTS.md): no hex
    colors, no brand class names, no raw <section>. Uses only primitives that
    exist in every pack. Import WITH CONTEXT:

      {%- from "modules/verifiers/classifiers.j2" import
          classify_actions, cluster_activity, apply_to_agents with context %}

    These slides assume the four-kinds slide in verifiers.j2 has already been
    shown: classifiers and clustering are the "machine learning" kind.
-#}

{%- from "modules/branding/" ~ branding ~ "/primitives.j2" import
    content_slide,
    slide_heading,
    card_grid,
    pipe,
    callout
-%}


{%- macro classify_actions() -%}
{#- Labels on the left, decision on the right: the classifier does not decide,
    it labels, and a plain policy maps label to outcome. That split keeps the
    gate deterministic even though the labeller is probabilistic. -#}
{%- call content_slide("Classifiers") %}
  {{ slide_heading("",
                   "Classifiers label every action",
                   "The label, not the model, drives the decision.") }}
  {{ card_grid([
    {"title": "Kind of action",
     "body": "Read, write, or delete.",
     "accent": "info"},
    {"title": "Where it goes",
     "body": "Internal or external destination.",
     "accent": "primary"},
    {"title": "What it touches",
     "body": "Secrets, credentials, personal data.",
     "accent": "warning"},
    {"title": "What it changes",
     "body": "Permissions, roles, or the agent&rsquo;s own configuration.",
     "accent": "danger"},
  ], cols=4) }}
  {{ pipe([
    {"label": "Allow",  "detail": "Low-risk labels proceed",          "accent": "success"},
    {"label": "Review", "detail": "Ambiguous or sensitive labels",    "accent": "warning"},
    {"label": "Deny",   "detail": "Labels policy forbids outright",   "accent": "danger"},
  ]) }}
  {{ callout("A classifier is the <strong>machine learning</strong> kind of verifier:
              cheap and fast enough to run on every action, but probabilistic.
              Let it route to review. Let <strong>software</strong> hold the deny.",
             accent="primary") }}
{%- endcall %}
{%- endmacro -%}


{%- macro cluster_activity() -%}
{#- Clustering is the unlabelled counterpart: nobody has to say in advance
    what bad looks like. The OWASP ASI references tie the idea to named risks
    without claiming clustering catches them all. -#}
{%- call content_slide("Clustering") %}
  {{ slide_heading("",
                   "Clustering finds what nobody labelled",
                   "Group similar sessions. Watch the edges.") }}
  {{ card_grid([
    {"title": "A new cluster",
     "body": "Sessions that look like nothing seen before. A new tool mix, a new destination, a new time of day.",
     "accent": "danger"},
    {"title": "A drifting cluster",
     "body": "A familiar group that slowly moves. Small steps that no single review would flag.",
     "accent": "warning"},
    {"title": "A lone outlier",
     "body": "One session far from every group. Worth a look, rarely worth a page.",
     "accent": "info"},
  ], cols=3) }}
  {{ card_grid([
    {"title": "Rogue agents",
     "body": "OWASP ASI10. Behaviour that departs from what the agent was deployed to do.",
     "accent": "secondary"},
    {"title": "Cascading failures",
     "body": "OWASP ASI08. One fault repeated across many sessions shows up as a cluster growing fast.",
     "accent": "secondary"},
    {"title": "Goal hijack",
     "body": "OWASP ASI01. A hijacked agent often still acts plausibly, but in an unusual sequence.",
     "accent": "secondary"},
  ], cols=3) }}
{%- endcall %}
{%- endmacro -%}


{%- macro apply_to_agents() -%}
{#- The loop, then the honest limits. Limits sit on the same slide as the
    pipeline on purpose: a pipeline alone reads as a product pitch, and the
    first limit (telemetry) is also the first stage. -#}
{%- call content_slide("Applying it") %}
  {{ slide_heading("",
                   "Putting it to work on agents") }}
  {{ pipe([
    {"label": "Capture",  "detail": "Tool calls and hook events",   "accent": "info"},
    {"label": "Classify", "detail": "Label each action",            "accent": "primary"},
    {"label": "Cluster",  "detail": "Group sessions, find outliers", "accent": "secondary"},
    {"label": "Alert",    "detail": "Route to a human",             "accent": "warning"},
    {"label": "Feedback", "detail": "Findings become rules",        "accent": "success"},
  ]) }}
  {{ card_grid([
    {"title": "Needs the telemetry first",
     "body": "No captured events, nothing to classify or cluster. Start there.",
     "accent": "neutral"},
    {"title": "False positives",
     "body": "Unusual is not the same as unsafe. Unreviewed alerts get ignored.",
     "accent": "neutral"},
    {"title": "Baselines drift",
     "body": "Legitimate change looks like an attack. A slow attack looks like legitimate change.",
     "accent": "neutral"},
  ], cols=3) }}
  {{ callout("These are advisory signals. <strong>Findings become deterministic rules</strong>;
              the model never holds the gate.", accent="success") }}
{%- endcall %}
{%- endmacro -%}
