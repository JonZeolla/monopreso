{# ================================================================
   Zenable — Brand-pack primitives
   ----------------------------------------------------------------
   Implements the primitive macro contract using Tailwind + the
   `zenable.*` color tokens from modules/shared/tailwind.config.js.

   Delegates to the long-standing Zenable-flavored macros in
   modules/shared/components/modern_macros.j2 where signatures
   already match.

   See AGENTS.md (repo root) for the full contract and accent vocab.
   ================================================================ #}

{%- from "modules/shared/components/modern_macros.j2" import
    card as _legacy_card,
    card_grid as _legacy_card_grid,
    section_label as _legacy_section_label,
    flow_steps as _legacy_flow_steps,
    pill as _legacy_pill
-%}


{# ── internal helpers ─────────────────────────────────────────── #}

{%- macro _accent_to_zen(name) -%}
{# Map semantic accent → Zenable Tailwind token #}
{%- set m = {
  "primary":  "teal",
  "secondary":"blue",
  "success":  "teal",
  "warning":  "amber",
  "danger":   "red",
  "info":     "blue",
  "neutral":  "slate",
} -%}{{- m.get(name, "slate") -}}
{%- endmacro -%}


{# ── structural primitives ────────────────────────────────────── #}

{%- macro title_slide(title, subtitle="", kicker="") -%}
<section class="slide flex items-center justify-center p-8" data-label="Title">
  <div class="text-center fade-in">
    {%- if kicker %}<p class="text-xs font-semibold uppercase tracking-[0.2em] text-zenable-teal mb-3">{{ kicker|safe }}</p>{% endif %}
    <h1 class="text-[64px] font-bold mb-[18px] tracking-tight text-white">{{ title }}</h1>
    {%- if subtitle %}<p class="text-2xl font-medium italic gradient-text">{{ subtitle|safe }}</p>{% endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro section_divider(num, title, subtitle="") -%}
<section class="slide flex items-center justify-center p-8" data-label="Section: {{ title }}">
  <div class="max-w-5xl mx-auto w-full text-center fade-in">
    <h2 class="text-6xl font-bold text-white mb-4 tracking-tight">{% if num %}{{ num }} · {% endif %}{{ title }}</h2>
    {%- if subtitle %}<p class="text-xl text-slate-400">{{ subtitle|safe }}</p>{% endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro maturity_level(level, stage, title, subtitle="") -%}
<section class="slide flex items-center justify-center p-8" data-label="{% if level %}Level {{ level }}: {{ stage }}{% else %}{{ title }}{% endif %}">
  <div class="max-w-5xl mx-auto w-full text-center fade-in">
    {%- if level %}<p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-zenable-teal mb-3">Level {{ level }}: {{ stage }}</p>{% endif %}
    <h2 class="text-5xl font-bold gradient-text pb-2">{{ title }}</h2>
    {%- if subtitle %}<p class="text-xl text-slate-400 mt-4">{{ subtitle|safe }}</p>{% endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro content_slide(label) -%}
{# Call-block wrapper owning the <section> + data-label, so a shared slide
   never has to name a brand-specific section class:
     {%- call content_slide("Lifecycle") %} ...body... {%- endcall %} #}
<section class="slide flex flex-col justify-center p-12" data-label="{{ label }}">
  <div class="max-w-6xl mx-auto w-full fade-in">
    {{ caller() }}
  </div>
</section>
{%- endmacro -%}

{%- macro slide_heading(label, title, subtitle="") -%}
{%- if label %}{{ _legacy_section_label(label) }}{% endif %}
<h3 class="text-4xl font-bold text-white mb-2">{{ title }}</h3>
{%- if subtitle %}<p class="text-lg text-slate-400 italic mb-8">{{ subtitle|safe }}</p>{% endif %}
{%- endmacro -%}


{# ── content primitives ───────────────────────────────────────── #}

{%- macro _accent_tw(name) -%}
{# Semantic accent → a Tailwind colour that actually exists.

   Do not route these through `zenable-*`: tailwind.config.js defines only
   bg / bg-light / teal / teal-dark / blue under that namespace, and Tailwind
   silently emits nothing for an undefined colour — so `border-zenable-amber`
   renders as no border at all rather than failing loudly. #}
{%- set m = {
  "primary":  "teal-400",
  "secondary":"purple-400",
  "success":  "emerald-400",
  "warning":  "amber-400",
  "danger":   "rose-400",
  "info":     "sky-400",
  "neutral":  "slate-400",
} -%}{{- m.get(name, "slate-400") -}}
{%- endmacro -%}

{%- macro callout(text, accent="primary") -%}
<div class="mt-6 p-4 rounded-xl border bg-zenable-bg-light/40 border-{{ _accent_tw(accent) }}/30 text-center text-slate-300">
  {{ text|safe }}
</div>
{%- endmacro -%}

{%- macro pros_cons(benefits, shortcomings, ben_label="Benefits", short_label="Shortcomings") -%}
<div class="grid grid-cols-2 gap-8 w-full">
  <div>
    <p class="text-xs font-bold tracking-[0.2em] uppercase text-emerald-400 mb-4">{{ ben_label }}</p>
    <div class="space-y-3">
      {%- for item in benefits %}
      <div class="p-4 rounded-xl bg-emerald-500/5 border border-emerald-500/20">
        <p class="font-semibold text-white">{{ item.title }}</p>
        {%- if item.detail %}<p class="text-sm text-slate-400 mt-1">{{ item.detail|safe }}</p>{% endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
  <div>
    <p class="text-xs font-bold tracking-[0.2em] uppercase text-rose-400 mb-4">{{ short_label }}</p>
    <div class="space-y-3">
      {%- for item in shortcomings %}
      <div class="p-4 rounded-xl bg-rose-500/5 border border-rose-500/20">
        <p class="font-semibold text-white">{{ item.title }}</p>
        {%- if item.detail %}<p class="text-sm text-slate-400 mt-1">{{ item.detail|safe }}</p>{% endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
{%- endmacro -%}

{%- macro pill_row(items, justify="center") -%}
<div class="flex flex-wrap gap-2 justify-{{ justify }} my-4">
  {%- for item in items %}
    {{ _legacy_pill(item.label, _accent_to_zen(item.accent | default("neutral"))) }}
  {%- endfor %}
</div>
{%- endmacro -%}

{%- macro card(title, body, accent="neutral") -%}
{{ _legacy_card(title, body, _accent_to_zen(accent)) }}
{%- endmacro -%}

{%- macro card_grid(items, cols=3, size="md", reveal=false) -%}
{#- `reveal=true` wraps the whole grid in a single `.step`, so every card
    arrives together on one key press while its space stays reserved — for a
    slide that states a definition first and shows the taxonomy second. -#}
{# size="lg" bumps title/body type for slides where the grid IS the slide. #}
{# Convert primitive item shape to legacy card_grid shape: {title, desc, accent} #}
{%- set legacy_items = [] -%}
{%- for it in items -%}
  {%- set _ = legacy_items.append({
    "title": it.title,
    "desc":  it.body | default(it.detail | default("")),
    "accent": _accent_to_zen(it.accent | default("neutral")),
  }) -%}
{%- endfor -%}
{% if reveal %}<div class="step">{% endif %}{% if size == "lg" %}<div class="cards-lg">{% endif %}{{ _legacy_card_grid(legacy_items, cols) }}{% if size == "lg" %}</div>{% endif %}{% if reveal %}</div>{% endif %}
{%- endmacro -%}


{# Vertical numbered list: an accent-coloured circle per step, joined by a
   connector line, with a title and optional detail beside it. Each item:
   {title, detail?, accent?}.

   Use this instead of `pipe()` when the sequence is a narrative to be read
   down the slide rather than a flow to be scanned across it — five stages with
   a sentence each are unreadable squeezed into horizontal cards, and the
   numbers make the ordering explicit rather than implied by arrows. #}
{%- macro numbered_steps(items) -%}
<div class="flex flex-col w-full">
  {%- for item in items %}
  {%- set tw = _accent_tw(item.accent | default("neutral")) %}
  <div class="flex gap-6">
    <div class="flex-none flex flex-col items-center">
      <div class="w-12 h-12 flex-none rounded-full border-2 border-{{ tw }} flex items-center justify-center">
        <span class="text-xl font-bold text-{{ tw }}">{{ loop.index }}</span>
      </div>
      {%- if not loop.last %}<div class="w-0.5 flex-1 min-h-[20px] bg-{{ tw }}/40"></div>{% endif %}
    </div>
    <div class="{% if not loop.last %}pb-7{% endif %} pt-1.5">
      <p class="text-2xl font-bold text-white m-0 leading-tight">{{ item.title }}</p>
      {%- if item.detail %}<p class="text-base text-slate-400 mt-1.5 m-0 leading-snug">{{ item.detail|safe }}</p>{% endif %}
    </div>
  </div>
  {%- endfor %}
</div>
{%- endmacro -%}


{%- macro pipe(stages, reveal=false, size="md") -%}
{# Left-to-right pipeline of stage cards joined by arrows.
   Each stage: {label, detail?, meta?, accent?, note?, below?}

   `note` renders as an annotation hanging above the stage on a dotted
   connector; `below` renders under the card. `size="lg"` scales the type up
   for slides where the pipeline IS the slide. #}
{%- set lg = (size == "lg") %}
{#- reveal: false = static. true / "below" = the below-labels arrive together
    on one press. "stages" = the cards themselves arrive one at a time, each
    with the arrow that leads to it. -#}
{%- set reveal_stages = (reveal == "stages") %}
{%- set reveal_below = (reveal and not reveal_stages) %}
{%- set has_notes = stages | selectattr("note", "defined") | list | length > 0 %}
{%- set has_below = stages | selectattr("below", "defined") | list | length > 0 %}
{#- ── Layout ─────────────────────────────────────────────────────
    A grid, not a flex row. Rows are: note gutter (optional), the cards, then
    the below labels (optional). Arrows live in the CARD row only, so they
    centre on the cards no matter how many lines of below text hang under the
    tallest column. A flex row centred each arrow in the whole column, which
    dragged them well below the cards as soon as one stage had five controls
    listed under it. -#}
{%- set card_row = 2 if has_notes else 1 %}
<div class="grid justify-center my-5" style="grid-auto-flow:column; align-items:start;
     grid-template-columns:{% for s in stages %}{% if not loop.first %} auto{% endif %} {{ 'auto' if lg else 'minmax(0,1fr)' }}{% endfor %};
     column-gap:{{ '16px' if lg else '8px' }};">
  {%- for stage in stages %}
  {%- set col = loop.index0 * 2 + 1 %}
  {%- set tw = _accent_tw(stage.accent | default("neutral")) %}
  {%- if not loop.first %}
  <div aria-hidden="true" class="flex items-center justify-center text-slate-600 {% if lg %}text-5xl{% else %}text-3xl{% endif %} leading-none{% if reveal_stages %} step{% endif %}"
       {%- if reveal_stages %} data-step="pipe-stage-{{ loop.index }}"{% endif %}
       style="grid-column:{{ col - 1 }}; grid-row:{{ card_row }}; align-self:stretch;">&rarr;</div>
  {%- endif %}
  {%- if has_notes %}
  <div class="min-h-[96px] flex flex-col items-center justify-end{% if reveal_stages %} step{% endif %}"
       {%- if reveal_stages %} data-step="pipe-stage-{{ loop.index }}"{% endif %}
       style="grid-column:{{ col }}; grid-row:1;">
    {%- if stage.note %}
    <div class="rounded-lg border border-{{ tw }}/40 bg-zenable-bg-light/80 px-2.5 py-2 text-center">
      <p class="text-[13px] font-bold leading-snug text-{{ tw }} m-0">{{ stage.note|safe }}</p>
    </div>
    <div aria-hidden="true" class="h-3.5 border-l-2 border-dotted border-{{ tw }}/60"></div>
    {%- endif %}
  </div>
  {%- endif %}
  <div class="rounded-xl border border-{{ tw }}/30 bg-{{ tw }}/5 {% if lg %}px-8 py-7{% else %}px-3 py-4{% endif %} text-center flex flex-col justify-center gap-1.5{% if reveal_stages %} step{% endif %}"
       {%- if reveal_stages %} data-step="pipe-stage-{{ loop.index }}"{% endif %}
       style="grid-column:{{ col }}; grid-row:{{ card_row }}; {% if lg %}justify-self:center;{% else %}align-self:stretch;{% endif %}">
    <p class="{% if lg %}text-3xl whitespace-nowrap{% else %}text-base{% endif %} font-bold text-{{ tw }} m-0">{{ stage.label }}</p>
    {%- if stage.detail %}<p class="{% if lg %}text-base{% else %}text-[13px]{% endif %} leading-snug text-slate-400 m-0">{{ stage.detail|safe }}</p>{% endif %}
    {%- if stage.meta %}<p class="font-mono text-[11px] uppercase tracking-wider text-slate-500 m-0">{{ stage.meta }}</p>{% endif %}
  </div>
  {%- if has_below %}
  <div style="grid-column:{{ col }}; grid-row:{{ card_row + 1 }};">
    {%- if stage.below %}
    <p class="mt-2 text-center {% if lg %}text-xl{% else %}text-[15px]{% endif %} leading-snug text-slate-400 m-0{% if reveal_below %} step{% endif %}"
       {%- if reveal_below %} data-step="pipe-below"{% endif %}>{{ stage.below|safe }}</p>
    {%- endif %}
  </div>
  {%- endif %}
  {%- endfor %}
</div>
{%- endmacro -%}


{%- macro statement(lines) -%}
{# Full-slide declarative statement. No quote marks, no attribution — this
   is the deck asserting something, not citing someone.
   `lines`: [{text, muted?}] — one per rendered line. Muted lines render
   smaller and dimmer, so connective words recede and the nouns carry. #}
<section class="slide flex items-center justify-center p-8" data-label="Statement">
  <div class="text-center fade-in">
    {%- for line in lines %}
    {%- if line.muted %}
    <p class="text-3xl font-normal leading-tight text-slate-500 m-0">{{ line.text|safe }}</p>
    {%- else %}
    <p class="text-[64px] font-extrabold leading-none tracking-tight text-white m-0">{{ line.text|safe }}</p>
    {%- endif %}
    {%- endfor %}
  </div>
</section>
{%- endmacro -%}


{%- macro image_slide(src, alt, label="", caption="") -%}
{# Full-slide image. The picture IS the slide: it scales to the viewport
   and nothing competes with it. `alt` is required — it is the only thing
   a screen reader or a failed load has to go on. #}
<section class="slide flex items-center justify-center p-8" data-label="{{ label or alt }}">
  <div class="text-center fade-in">
    <img src="{{ src }}" alt="{{ alt }}"
         class="mx-auto rounded-xl object-contain"
         style="max-height:calc(100vh - {{ '10rem' if caption else '4rem' }}); max-width:calc(100vw - 4rem); width:auto; height:auto;">
    {%- if caption %}
    <p class="text-base text-slate-400 mt-6 m-0">{{ caption|safe }}</p>
    {%- endif %}
  </div>
</section>
{%- endmacro -%}


{%- macro quote(text, attribution, source="", url="") -%}
{# Full-slide pull quote. `attribution` is the speaker; `source` is where
   they said it; `url` makes the source a link. #}
<section class="slide flex items-center justify-center p-8" data-label="Quote">
  <div class="max-w-4xl mx-auto w-full text-center fade-in">
    <p class="text-[46px] font-bold leading-tight text-white mb-7">&ldquo;{{ text|safe }}&rdquo;</p>
    <p class="text-lg font-semibold text-zenable-teal m-0">{{ attribution }}</p>
    {%- if source %}
    <p class="text-[13px] text-slate-500 mt-1.5 m-0">
      {% if url %}<a href="{{ url }}" class="text-slate-400">{{ source }}</a>{% else %}{{ source }}{% endif %}
    </p>
    {%- endif %}
  </div>
</section>
{%- endmacro -%}


{%- macro matrix(headers, rows, caption="") -%}
{# Comparison matrix. Columns are the things compared, rows are the
   dimensions they are compared on.

     headers: [{label, sub?}]
     rows:    [{label, cells}]  where cells: [{level, text?}]
     level:   strong | partial | weak

   Read down a column for one option's profile; read across a row to see
   which options cover that dimension. That second reading is the point:
   it shows gaps being filled. #}
{%- set _lvl = {"strong": "success", "partial": "warning", "weak": "danger"} %}
{%- set _sym = {"strong": "●", "partial": "◐", "weak": "○"} %}
<div class="my-4">
  <div class="grid gap-1.5 items-stretch" style="grid-template-columns:minmax(140px,1.25fr) repeat({{ headers|length }}, 1fr);">
    <div></div>
    {%- for h in headers %}
    <div class="text-center p-1">
      <p class="text-[13px] font-bold text-slate-200 m-0">{{ h.label }}</p>
      {%- if h.sub %}<p class="text-[10px] text-slate-500 m-0">{{ h.sub }}</p>{% endif %}
    </div>
    {%- endfor %}
    {%- for row in rows %}
    <div class="flex items-center px-2 py-1">
      <p class="text-xs font-semibold leading-snug text-slate-200 m-0">{{ row.label|safe }}</p>
    </div>
    {%- for cell in row.cells %}
    {%- set tw = _accent_tw(_lvl.get(cell.level, "neutral")) %}
    <div class="rounded-lg border border-{{ tw }}/30 bg-{{ tw }}/5 px-1.5 py-2 text-center flex flex-col items-center justify-center gap-0.5"
         aria-label="{{ cell.level | default('unrated') }}">
      <span aria-hidden="true" class="text-[15px] leading-none text-{{ tw }}">{{ _sym.get(cell.level, "○") }}</span>
      {%- if cell.text %}<p class="text-[10px] leading-tight text-slate-400 m-0">{{ cell.text|safe }}</p>{% endif %}
    </div>
    {%- endfor %}
    {%- endfor %}
  </div>
  {%- if caption %}<p class="mt-2.5 text-center text-[11px] text-slate-500 m-0">{{ caption|safe }}</p>{% endif %}
</div>
{%- endmacro -%}


{%- macro tradeoff_triangle(corners, note="", filled=false) -%}
{# Good / fast / cheap style triangle. `corners` is exactly three
   {label, accent}. `note` renders inside the shape. `filled` lights the
   whole triangle instead of leaving it an outline.

   Colours ride on `currentColor` so the SVG works in every pack. #}
{%- set X = [230, 420, 40] %}
{%- set Y = [40, 362, 362] %}
{%- set SUBY = [62, 384, 384] %}
<div style="display:flex; justify-content:center; align-items:center; margin:10px 0;">
  <svg viewBox="-75 0 610 400" role="img" aria-label="{% for c in corners %}{{ c.label }}{% if not loop.last %}, {% endif %}{% endfor %}{% if note %} — {{ note }}{% endif %}"
       style="width:min(520px,60%); height:auto; max-height:46vh;">
    <g class="{% if filled %}text-emerald-400{% else %}text-slate-600{% endif %}">
      <polygon points="230,74 420,334 40,334"
               fill="currentColor" fill-opacity="{% if filled %}0.16{% else %}0{% endif %}"
               stroke="currentColor" stroke-width="{% if filled %}4{% else %}2.5{% endif %}"
               stroke-linejoin="round"/>
    </g>
    {%- for c in corners %}
    <g class="text-{{ _accent_tw(c.accent | default("neutral")) }}">
      <text x="{{ X[loop.index0] }}" y="{{ Y[loop.index0] }}" text-anchor="middle"
            fill="currentColor" font-size="25" font-weight="700"
            font-family="inherit">{{ c.label }}</text>
      {%- if c.sub %}
      <text x="{{ X[loop.index0] }}" y="{{ SUBY[loop.index0] }}" text-anchor="middle"
            fill="currentColor" font-size="15" font-weight="500" opacity="0.75"
            font-family="inherit">{{ c.sub }}</text>
      {%- endif %}
    </g>
    {%- endfor %}
    {%- if note %}
    <g class="text-slate-400">
      <text x="230" y="268" text-anchor="middle" fill="currentColor"
            font-size="22" font-weight="600" font-family="inherit">{{ note }}</text>
    </g>
    {%- endif %}
  </svg>
</div>
{%- endmacro -%}


{%- macro _score_color(score) -%}
{# Four-step scorecard ramp: red → orange → yellow → Zenable teal for the
   top step. Deliberately not part of the accent vocabulary — this is an
   ordinal scale, and `warning` vs `danger` carries no ordering. Inline hex
   rather than Tailwind classes so the ramp cannot silently vanish the way an
   undefined `zenable-*` colour does. #}
{%- set m = {
  1: "#fb7185",
  2: "#fb923c",
  3: "#fcd34d",
  4: "#00BAAE",
} -%}{{- m.get(score, "#64748b") -}}
{%- endmacro -%}

{%- macro meter_row(items, scale=4, caption="") -%}
{# Graded bars on one shared scale, so several slides can be read against
   each other. Each item: {label, score, note}; `score` is 1..scale where
   scale is the most favourable. Length and colour encode the same number —
   redundant on purpose, since colour alone fails on a projector.

   The note column only exists when some item actually carries a note. With no
   notes the bars span the full width of the slide instead of leaving a dead
   third column, so they line up with whatever sits above them. #}
{%- set has_notes = items | selectattr("note") | list | length > 0 %}
<div class="flex flex-col gap-4 mt-10 mb-1">
  {%- for item in items %}
  {%- set _s = item.score | default(0) %}
  <div class="grid items-center gap-4" style="grid-template-columns:minmax(140px,{% if has_notes %}0.85fr{% else %}210px{% endif %}) {% if has_notes %}minmax(200px,1.6fr) minmax(160px,1.1fr){% else %}1fr{% endif %};">
    <p class="text-base font-semibold text-white m-0">{{ item.label }}</p>
    <div role="img" aria-label="{{ item.label }}: {{ _s }} of {{ scale }}" class="flex gap-1.5">
      {%- for i in range(1, scale + 1) %}
      <span class="flex-1 rounded-full" style="height:16px; background:{% if i <= _s %}{{ _score_color(_s) }}{% else %}rgba(100,116,139,0.3){% endif %};"></span>
      {%- endfor %}
    </div>
    {%- if has_notes %}{% if item.note %}
    <p class="text-xs text-slate-400 m-0 leading-snug">{{ item.note|safe }}</p>
    {%- else %}<span></span>{% endif %}{% endif %}
  </div>
  {%- endfor %}
</div>
{%- if caption %}<p class="mt-2.5 text-center text-[11px] text-slate-500 m-0">{{ caption|safe }}</p>{% endif %}
{%- endmacro -%}


{# ────────────────────────────────────────────────────────────────
   NOT YET IMPLEMENTED — declared in AGENTS.md contract.
   When extracting the shared slide that needs them, either:
     - delegate to a matching macro in
       modules/shared/components/modern_macros.j2, or
     - implement fresh here following the contract.

     code_block(filename, lines)
     step_flow(steps)         # candidate: wrap _legacy_flow_steps
     ide_mockup(filename, sidebar, code_lines, chat_panel=None)
   ──────────────────────────────────────────────────────────────── #}
