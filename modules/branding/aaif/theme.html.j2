{# ================================================================
   Agentic AI Foundation (AAIF) — brand pack theme
   ----------------------------------------------------------------
   Tokens, type, and slide chrome for the AAIF *chapter/event* deck
   style. Every value below is lifted from the official "AAIF
   Presentation Template" Google Slides deck (Slides.pptx, 23 slides)
   rather than eyeballed:

     canvas       9144000 x 5143500 EMU  =  10in x 5.625in  (16:9)
     background   #F6F5F1
     ink / muted  #0A0A0A / #4A4A4A
     hairline     #C9C6BF   (strong: #9A978F)
     accent       #14964A   ("tonight" green)
     display      Space Grotesk Bold
     body         Instrument Sans
     chrome       JetBrains Mono

   ── The pt unit ────────────────────────────────────────────────
   The source deck sets type in points on a 720pt-wide canvas, so a
   point is exactly 1/7.2 of the slide width. `--pt` encodes that:

       font-size: calc(21 * var(--pt))   <-- the deck's `sz="2100"`

   Because --pt is derived from `cqw` on .aaif-stage, every size
   scales with the slide and stays proportionally identical to the
   source at any window size. Copy `sz` values out of the pptx
   verbatim; do not convert them to px.

   ── The stage ──────────────────────────────────────────────────
   .aaif-slide fills the viewport and paints the background colour.
   .aaif-stage is a 16:9 box centred inside it — the actual slide
   canvas. Because the background is on the outer element there is
   no visible letterboxing when the window is not 16:9; the content
   box just stops scaling.

   Include this file ONCE, at the top of a deck. It emits the logo
   sprite for you.
   ================================================================ #}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Instrument+Sans:ital,wght@0,400..700;1,400..700&amp;family=JetBrains+Mono:ital,wght@0,400..700;1,400..700&amp;family=Space+Grotesk:wght@400..700&amp;display=swap">

{%- include "modules/branding/aaif/logo-sprite.html.j2" %}

<style>
:root {
  /* ── palette ─────────────────────────────────────────────── */
  --aaif-cream:        #F6F5F1;   /* slide background            */
  --aaif-ink:          #0A0A0A;   /* headings, marks             */
  --aaif-muted:        #4A4A4A;   /* body copy, chrome           */
  --aaif-rule:         #C9C6BF;   /* hairlines, table borders    */
  --aaif-rule-strong:  #9A978F;   /* outlined chips, connectors  */
  --aaif-green:        #14964A;   /* the one accent in the deck  */

  --aaif-navy:         #1A2332;   /* dark slide, deck p13        */
  --aaif-charcoal:     #252525;   /* dark slide, deck p14        */

  /* on-dark chrome, sampled from deck p10/p13/p14/p15 */
  --aaif-d-rule:       #8E94A1;
  --aaif-d-chrome:     #C9C7C0;
  --aaif-d-label:      #B9BFCB;
  --aaif-d-body:       #D5DAE3;

  /* ── semantic accents (contract vocabulary) ──────────────── */
  --aaif-a-primary:    var(--aaif-ink);
  --aaif-a-secondary:  var(--aaif-green);
  --aaif-a-success:    var(--aaif-green);
  --aaif-a-warning:    #A8741C;
  --aaif-a-danger:     #A33A2A;
  --aaif-a-info:       #1B7F99;
  --aaif-a-neutral:    var(--aaif-rule-strong);

  /* ── type families ───────────────────────────────────────── */
  --aaif-display: "Space Grotesk", "Instrument Sans", system-ui, sans-serif;
  --aaif-body:    "Instrument Sans", system-ui, -apple-system, sans-serif;
  --aaif-mono:    "JetBrains Mono", ui-monospace, "SF Mono", Menlo, monospace;

  /* ── canvas geometry, as fractions of the slide ──────────── */
  --aaif-gutter:      5%;      /* every content block starts here */
  --aaif-head-top:    15.11%;  /* eyebrow row                     */
  --aaif-title-top:   20.98%;  /* section title row               */
  --aaif-rule-y:      90.31%;  /* footer hairline                 */
  --aaif-foot-y:      91.73%;  /* footer text row                 */
}

/* ── slide shell ──────────────────────────────────────────────
   The section paints the background; the stage is the 16:9 canvas
   everything is positioned inside. */
.aaif-slide {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  width: 100%;
  background: var(--aaif-cream);
  color: var(--aaif-ink);
  font-family: var(--aaif-body);
  counter-increment: aaif-page;
  overflow: hidden;
}
.aaif-slide--nonumber { counter-increment: none; }

.aaif-stage {
  position: relative;
  width:  min(100vw, calc(100vh * 16 / 9));
  height: min(100vh, calc(100vw * 9 / 16));
  container-type: size;
  container-name: aaif;
}

/* --pt lives here, not on .aaif-stage: a container query unit
   resolves against the nearest ANCESTOR container, so it has to be
   read from inside the stage rather than on it. */
.aaif-canvas {
  position: absolute;
  inset: 0;
  --pt: calc(1cqw / 7.2);
}

/* ── tone variants ───────────────────────────────────────────── */
.aaif-slide--light    { background: var(--aaif-cream);    color: var(--aaif-ink); }
.aaif-slide--navy     { background: var(--aaif-navy);     color: #fff; }
.aaif-slide--dark     { background: var(--aaif-charcoal); color: #fff; }

/* The deck's mesh-gradient background. This is the deck's own
   2048x1152 PNG, downsampled to 320x180 and inlined as a data URI —
   a smooth mesh survives that losslessly to the eye and costs ~10KB
   instead of 700KB, and it keeps a rendered deck a single
   self-contained HTML file. The layered radial-gradient fallback
   underneath keeps the slide readable if the URI is ever stripped. */
.aaif-slide--gradient {
  background-color: #0B0A0C;
  background-image:
    url("data:image/jpeg;base64,"),
    radial-gradient(75% 62% at 20%  6%,  #1D95B1 0%, rgba(29,149,177,0) 62%),
    radial-gradient(58% 66% at 76% 44%,  #A455AB 0%, rgba(164,85,171,0) 66%),
    radial-gradient(46% 44% at 30% 94%,  #543F22 0%, rgba(84,63,34,0)   70%),
    radial-gradient(48% 52% at 88% 86%,  #7B4180 0%, rgba(123,65,128,0) 70%);
  background-size: cover;
  background-position: center;
  color: #fff;
}

.aaif-slide--navy .aaif-eyebrow,
.aaif-slide--dark .aaif-eyebrow,
.aaif-slide--gradient .aaif-eyebrow,
.aaif-slide--navy .aaif-foot,
.aaif-slide--dark .aaif-foot,
.aaif-slide--gradient .aaif-foot   { color: var(--aaif-d-chrome); }

.aaif-slide--navy .aaif-hairline,
.aaif-slide--dark .aaif-hairline,
.aaif-slide--gradient .aaif-hairline { background: var(--aaif-d-rule); }

.aaif-slide--navy .aaif-wordmark,
.aaif-slide--dark .aaif-wordmark,
.aaif-slide--gradient .aaif-wordmark,
.aaif-slide--navy .aaif-mark,
.aaif-slide--dark .aaif-mark,
.aaif-slide--gradient .aaif-mark   { color: #fff; }

.aaif-slide--navy .aaif-label,
.aaif-slide--dark .aaif-label      { color: var(--aaif-d-label); }
.aaif-slide--gradient .aaif-label  { color: #E8E6DF; }

.aaif-slide--navy .aaif-title,
.aaif-slide--dark .aaif-title,
.aaif-slide--gradient .aaif-title  { color: #fff; }

.aaif-slide--navy .aaif-lead,
.aaif-slide--navy .aaif-body-text  { color: var(--aaif-d-body); }
.aaif-slide--dark .aaif-lead,
.aaif-slide--dark .aaif-body-text  { color: #DDDBD4; }
.aaif-slide--gradient .aaif-lead,
.aaif-slide--gradient .aaif-body-text { color: #EDEBE4; }

.aaif-slide--navy .aaif-mono,
.aaif-slide--dark .aaif-mono,
.aaif-slide--gradient .aaif-mono   { color: #fff; }

/* ── chrome ───────────────────────────────────────────────────
   Logo mark + wordmark top-left, mono eyebrow top-right, hairline
   and footer row along the bottom. Emitted by chrome() in
   primitives.j2 so every layout carries an identical set. */
.aaif-mark {
  position: absolute;
  left: 5%; top: 5.33%;
  width: 2.7%; height: 4.8%;
  color: var(--aaif-ink);
}
.aaif-wordmark {
  position: absolute;
  left: 8.6%; top: 4.8%;
  font-family: var(--aaif-body);
  font-weight: 700;
  font-size: calc(7.5 * var(--pt));
  line-height: 1.1333;
  letter-spacing: -0.005em;
  color: var(--aaif-ink);
  white-space: pre-line;
}
.aaif-eyebrow {
  position: absolute;
  right: 5%; top: 4.8%;
  font-family: var(--aaif-mono);
  font-size: calc(7.5 * var(--pt));
  letter-spacing: 0.02em;
  text-transform: uppercase;   /* the deck's eyebrow is always caps */
  color: var(--aaif-muted);
  text-align: right;
}
.aaif-hairline {
  position: absolute;
  left: 5%; width: 90%;
  top: var(--aaif-rule-y);
  height: 1px;
  background: var(--aaif-rule);
}
.aaif-foot {
  position: absolute;
  top: var(--aaif-foot-y);
  font-family: var(--aaif-mono);
  font-size: calc(7.5 * var(--pt));
  color: var(--aaif-muted);
}
.aaif-foot--left  { left: 5%; text-decoration: underline; text-underline-offset: 0.25em; }
.aaif-foot--right { right: 5%; text-align: right; }
.aaif-foot--right::after { content: counter(aaif-page, decimal-leading-zero); }

/* ── heading block ────────────────────────────────────────────
   Eyebrow at 15.11%, title at 20.98% — the offsets every content
   slide in the source deck uses. The eyebrow's fixed height is what
   lands the title on its row regardless of eyebrow presence. */
.aaif-head {
  position: absolute;
  left: var(--aaif-gutter);
  right: var(--aaif-gutter);
  /* +3.6pt reproduces the 0.05in top inset Google Slides applies
     inside every text box, so our first line sits on the deck's. */
  top: calc(var(--aaif-head-top) + 3.6 * var(--pt));
}
.aaif-label {
  font-family: var(--aaif-mono);
  font-size: calc(9 * var(--pt));
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--aaif-muted);
  /* 12.15pt line box + 11.6pt margin = the deck's 23.8pt eyebrow
     row, which is what lands the title on its own row at 20.98%. */
  margin: 0 0 calc(11.6 * var(--pt)) 0;
  height: calc(9 * var(--pt) * 1.35);
}
.aaif-label--sm  { font-size: calc(8.5 * var(--pt)); height: auto; margin: 0; }
.aaif-label--green { color: var(--aaif-green); }

.aaif-title {
  font-family: var(--aaif-display);
  font-weight: 700;
  font-size: calc(21 * var(--pt));
  line-height: 1.18;
  letter-spacing: -0.02em;
  color: var(--aaif-ink);
  margin: 0;
}
.aaif-title--lg      { font-size: calc(23 * var(--pt)); }
.aaif-title--display { font-size: calc(40 * var(--pt)); line-height: 1.12; }
.aaif-title--hero    { font-size: calc(60 * var(--pt)); line-height: 1.02; letter-spacing: -0.035em; }
.aaif-title em, .aaif-title i { font-style: italic; font-weight: 400; }

.aaif-lead {
  font-family: var(--aaif-body);
  font-size: calc(13 * var(--pt));
  line-height: 1.45;
  color: var(--aaif-muted);
  margin: 0;
}
.aaif-body-text {
  font-family: var(--aaif-body);
  font-size: calc(12 * var(--pt));
  line-height: 1.5;
  color: var(--aaif-muted);
  margin: 0;
}
.aaif-mono {
  font-family: var(--aaif-mono);
  font-size: calc(9.5 * var(--pt));
  letter-spacing: 0.02em;
  color: var(--aaif-ink);
  margin: 0;
}

/* ── body region ──────────────────────────────────────────────
   Everything below the heading. `--top` lets a layout pin its own
   start row the way the source deck does. */
.aaif-body {
  position: absolute;
  left: var(--aaif-gutter);
  right: var(--aaif-gutter);
  top: calc(var(--top, 33.78%) + 3.6 * var(--pt));
  bottom: 12%;
}
.aaif-body--center {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

/* ── the oversized numeral on divider slides (deck p6/p9/p16) ── */
.aaif-numeral {
  position: absolute;
  right: 5%; top: 16.89%;
  font-family: var(--aaif-display);
  font-weight: 700;
  font-size: calc(96 * var(--pt));
  line-height: 0.92;
  letter-spacing: -0.045em;
  color: var(--aaif-ink);
  text-align: right;
}
.aaif-slide--navy .aaif-numeral,
.aaif-slide--dark .aaif-numeral,
.aaif-slide--gradient .aaif-numeral { color: #fff; }

/* ── cover slides ─────────────────────────────────────────────── */
.aaif-cover-mark {
  position: absolute;
  left: 5.5%; top: 6.04%;
  width: 3%; height: 5.33%;
  color: var(--aaif-ink);
}
.aaif-cover-wordmark {
  position: absolute;
  left: 9.5%; top: 5.51%;
  font-family: var(--aaif-display);
  font-weight: 700;
  font-size: calc(9 * var(--pt));
  line-height: 1.1111;
  letter-spacing: -0.01em;
  color: var(--aaif-ink);
  white-space: pre-line;
}
.aaif-slide--navy .aaif-cover-mark,
.aaif-slide--dark .aaif-cover-mark,
.aaif-slide--gradient .aaif-cover-mark,
.aaif-slide--navy .aaif-cover-wordmark,
.aaif-slide--dark .aaif-cover-wordmark,
.aaif-slide--gradient .aaif-cover-wordmark { color: #fff; }

/* ── stat callouts (deck p20) ─────────────────────────────────── */
.aaif-stat-value {
  font-family: var(--aaif-display);
  font-weight: 700;
  font-size: calc(60 * var(--pt));
  line-height: 1;
  letter-spacing: -0.04em;
  color: var(--aaif-ink);
}
.aaif-stat-value--md { font-size: calc(30 * var(--pt)); }
.aaif-stat-value--sm { font-size: calc(24 * var(--pt)); }
.aaif-slide--navy .aaif-stat-value,
.aaif-slide--dark .aaif-stat-value,
.aaif-slide--gradient .aaif-stat-value { color: #fff; }

/* ── table (deck p17) ─────────────────────────────────────────── */
.aaif-table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;
}
.aaif-table th,
.aaif-table td {
  border: 1px solid var(--aaif-rule);
  /* 4.32pt = the deck's 54875 EMU cell inset; the row height is what
     the deck actually fixes, so tables of any length keep its rhythm
     until you override --aaif-row-h. */
  padding: calc(4.32 * var(--pt)) calc(4.32 * var(--pt));
  height: var(--aaif-row-h, calc(27.4 * var(--pt)));
  text-align: left;
  vertical-align: middle;
}
.aaif-table th {
  background: var(--aaif-ink);
  color: var(--aaif-cream);
  font-family: var(--aaif-mono);
  font-weight: 700;
  font-size: calc(8.5 * var(--pt));
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.aaif-table td {
  font-family: var(--aaif-body);
  font-size: calc(9.5 * var(--pt));
  color: var(--aaif-ink);
  background: var(--aaif-cream);
}

/* ── timeline (deck p22) ──────────────────────────────────────── */
.aaif-timeline { position: relative; }
.aaif-timeline-rail {
  position: absolute;
  left: 2.1%; right: 20.6%;
  top: calc(2.67% + 0.5px);
  height: 1.5px;
  background: var(--aaif-rule-strong);
}
.aaif-timeline-row {
  position: relative;
  display: grid;
  gap: 0;
}
.aaif-dot {
  /* the deck's dot is 3% of the slide width = 21.6pt */
  width: calc(21.6 * var(--pt));
  aspect-ratio: 1;
  border-radius: 50%;
  background: var(--aaif-ink);
}
.aaif-dot--green { background: var(--aaif-green); }

/* ── numbered circles (deck p7 agenda) ────────────────────────── */
.aaif-circle {
  /* 4.2% of the slide width = 30.2pt */
  width: calc(30.2 * var(--pt));
  aspect-ratio: 1;
  border-radius: 50%;
  border: 1px solid var(--aaif-ink);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--aaif-mono);
  font-weight: 700;
  font-size: calc(11 * var(--pt));
  color: var(--aaif-ink);
}

/* ── avatar placeholder ───────────────────────────────────────
   The source deck ships raster placeholder headshots; this is the
   same silhouette drawn in CSS so a deck stays self-contained.
   Pass a real <img> through the macro's `photo` argument to
   replace it. */
.aaif-avatar {
  border-radius: 50%;
  background: var(--aaif-ink);
  position: relative;
  overflow: hidden;
  flex: none;
}
.aaif-avatar::before {
  content: "";
  position: absolute;
  left: 50%; top: 21%;
  width: 30%; aspect-ratio: 1;
  transform: translateX(-50%);
  border-radius: 50%;
  background: var(--aaif-cream);
}
.aaif-avatar::after {
  content: "";
  position: absolute;
  left: 50%; top: 60%;
  width: 62%; height: 55%;
  transform: translateX(-50%);
  border-radius: 50% 50% 0 0;
  background: var(--aaif-cream);
}
.aaif-avatar img {
  position: absolute; inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  border-radius: 50%;
}
/* The silhouette is a placeholder: a real photo replaces it entirely
   (::after is generated last, so it would otherwise paint on top). */
.aaif-avatar:has(img)::before,
.aaif-avatar:has(img)::after { content: none; }

/* ── outlined chip (host / member logo slots, deck p1/p2) ─────── */
.aaif-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--aaif-rule-strong);
  border-radius: calc(3 * var(--pt));
  background: transparent;
  font-family: var(--aaif-mono);
  font-weight: 700;
  font-size: calc(9.5 * var(--pt));
  letter-spacing: 0.03em;
  text-transform: uppercase;
  color: var(--aaif-ink);
  padding: calc(6 * var(--pt)) calc(8 * var(--pt));
  text-align: center;
}
.aaif-slide--navy .aaif-chip,
.aaif-slide--dark .aaif-chip,
.aaif-slide--gradient .aaif-chip {
  border-color: rgba(255,255,255,0.45);
  color: #fff;
}

/* ── contract primitives ──────────────────────────────────────
   The deck itself has no card vocabulary — it is hairlines and
   type. These render the contract's card/callout/pill in that same
   register: sharp corners, one hairline, one accent rule. */
.aaif-card {
  border: 1px solid var(--aaif-rule);
  border-left: calc(2.5 * var(--pt)) solid var(--aaif-a-neutral);
  background: transparent;
  padding: calc(9 * var(--pt)) calc(10 * var(--pt));
}
.aaif-card-title {
  font-family: var(--aaif-display);
  font-weight: 700;
  font-size: calc(11.5 * var(--pt));
  line-height: 1.25;
  letter-spacing: -0.01em;
  color: var(--aaif-ink);
  margin: 0 0 calc(3 * var(--pt)) 0;
}
.aaif-card-body {
  font-family: var(--aaif-body);
  font-size: calc(9.5 * var(--pt));
  line-height: 1.4;
  color: var(--aaif-muted);
  margin: 0;
}
.aaif-slide--navy .aaif-card,
.aaif-slide--dark .aaif-card,
.aaif-slide--gradient .aaif-card { border-color: rgba(255,255,255,0.28); }
.aaif-slide--navy .aaif-card-title,
.aaif-slide--dark .aaif-card-title,
.aaif-slide--gradient .aaif-card-title { color: #fff; }
.aaif-slide--navy .aaif-card-body,
.aaif-slide--dark .aaif-card-body,
.aaif-slide--gradient .aaif-card-body { color: rgba(255,255,255,0.86); }

.aaif-callout {
  border-left: calc(2.5 * var(--pt)) solid var(--aaif-a-primary);
  background: rgba(10,10,10,0.035);
  padding: calc(8 * var(--pt)) calc(10 * var(--pt));
  font-family: var(--aaif-body);
  font-size: calc(10.5 * var(--pt));
  line-height: 1.45;
  color: var(--aaif-ink);
}
.aaif-slide--navy .aaif-callout,
.aaif-slide--dark .aaif-callout,
.aaif-slide--gradient .aaif-callout {
  background: rgba(255,255,255,0.08);
  color: #fff;
}

.aaif-pill {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--aaif-a-neutral);
  border-radius: calc(3 * var(--pt));
  padding: calc(3.5 * var(--pt)) calc(7 * var(--pt));
  font-family: var(--aaif-mono);
  font-size: calc(8.5 * var(--pt));
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: var(--aaif-ink);
}
.aaif-slide--navy .aaif-pill,
.aaif-slide--dark .aaif-pill,
.aaif-slide--gradient .aaif-pill { border-color: rgba(255,255,255,0.45); color: #fff; }

/* accent hooks — semantic names only; shared slides never see hex */
.aaif-accent-primary   { --aaif-accent: var(--aaif-a-primary);   border-left-color: var(--aaif-a-primary); }
.aaif-accent-secondary { --aaif-accent: var(--aaif-a-secondary); border-left-color: var(--aaif-a-secondary); }
.aaif-accent-success   { --aaif-accent: var(--aaif-a-success);   border-left-color: var(--aaif-a-success); }
.aaif-accent-warning   { --aaif-accent: var(--aaif-a-warning);   border-left-color: var(--aaif-a-warning); }
.aaif-accent-danger    { --aaif-accent: var(--aaif-a-danger);    border-left-color: var(--aaif-a-danger); }
.aaif-accent-info      { --aaif-accent: var(--aaif-a-info);      border-left-color: var(--aaif-a-info); }
.aaif-accent-neutral   { --aaif-accent: var(--aaif-a-neutral);   border-left-color: var(--aaif-a-neutral); }
span.aaif-pill.aaif-accent-primary,
span.aaif-pill.aaif-accent-secondary,
span.aaif-pill.aaif-accent-success,
span.aaif-pill.aaif-accent-warning,
span.aaif-pill.aaif-accent-danger,
span.aaif-pill.aaif-accent-info,
span.aaif-pill.aaif-accent-neutral { border-color: var(--aaif-accent); color: var(--aaif-accent); }

