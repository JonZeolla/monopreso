{# SANS webcast series overview — single image.
   Vars:
     sans_series_image — path to the series-overview image
     sans_series_alt   — accessibility alt text describing the series & this part
#}
<section class="vis-slide" data-label="Series Overview" style="justify-content:center; align-items:center; padding-top:44px;">
  <img src="{{ sans_series_image }}"
       alt="{{ sans_series_alt }}"
       style="max-width:90%; max-height:80vh; border-radius:8px;" class="plain">
</section>
