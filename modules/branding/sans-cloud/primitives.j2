{# ================================================================
   SANS Cloud Security — Brand-pack primitives
   ----------------------------------------------------------------
   Implements the primitive macro contract used by shared slides under
   modules/<topic>/*.j2 (e.g. modules/context/, modules/agents/, modules/
   hooks/, modules/guardrails/, modules/ci-cd/, modules/outro/).
   Visuals come from the vis-* CSS classes
   defined in this pack's theme.html.j2.

   See AGENTS.md (repo root) for the full contract and accent vocab.
   ================================================================ #}


{# ── internal helpers ─────────────────────────────────────────── #}

{%- macro _accent_card_class(name) -%}
{%- set m = {
  "primary":  "vis-teal-card",
  "secondary":"vis-purple-card",
  "success":  "vis-green-card",
  "warning":  "vis-amber-card",
  "danger":   "vis-red-card",
  "info":     "vis-blue-card",
  "neutral":  "vis-card",
} -%}
{{- m.get(name, "vis-card") -}}
{%- endmacro -%}

{%- macro _accent_callout_class(name) -%}
{%- set m = {
  "primary":"vis-callout-teal",
  "success":"vis-callout-green",
  "warning":"vis-callout-amber",
  "info":   "vis-callout-teal",
  "neutral":"vis-callout-teal",
} -%}
{{- m.get(name, "vis-callout-teal") -}}
{%- endmacro -%}

{%- macro _pill_border(name) -%}
{%- set m = {
  "primary":"rgba(45,212,191,0.4)",
  "info":   "rgba(96,165,250,0.4)",
  "neutral":"rgba(100,116,139,0.4)",
} -%}{{- m.get(name, "rgba(100,116,139,0.4)") -}}
{%- endmacro -%}

{%- macro _pill_text(name) -%}
{%- set m = {
  "primary":"#2dd4bf",
  "info":   "#60a5fa",
  "neutral":"#94a3b8",
} -%}{{- m.get(name, "#94a3b8") -}}
{%- endmacro -%}

{%- macro _accent_text(name) -%}
{%- set m = {
  "primary":  "#2dd4bf",
  "secondary":"#c084fc",
  "success":  "#4ade80",
  "warning":  "#fbbf24",
  "danger":   "#f87171",
  "info":     "#60a5fa",
  "neutral":  "#e2e8f0",
} -%}{{- m.get(name, "#e2e8f0") -}}
{%- endmacro -%}


{# ── structural primitives ────────────────────────────────────── #}

{%- macro title_slide(title, subtitle="", kicker="") -%}
<section class="vis-slide" data-label="Title" style="justify-content:center; align-items:center; text-align:center;">
  <div>
    {%- if kicker %}<div class="vis-label" style="text-align:center;">{{ kicker }}</div>{% endif %}
    <h1 class="vis-title" style="font-size:64px; margin-bottom:18px;">{{ title }}</h1>
    {%- if subtitle %}<p class="vis-subtitle" style="font-size:22px;">{{ subtitle|safe }}</p>{% endif %}
  </div>
</section>
{%- endmacro -%}

{%- macro section_divider(num, title, subtitle="") -%}
<section class="sans-slide sans-section-divider" data-label="Section: {{ title }}">
  <h2>{% if num %}{{ num }} · {% endif %}{{ title }}</h2>
  {%- if subtitle %}<p>{{ subtitle|safe }}</p>{% endif %}
</section>
{%- endmacro -%}

{%- macro maturity_level(level, stage, title, subtitle="") -%}
<section class="sans-slide sans-section-divider" data-label="{% if level %}Level {{ level }}: {{ stage }}{% else %}{{ title }}{% endif %}">
  {%- if level %}<p style="font-size:16px; font-weight:700; letter-spacing:0.12em; text-transform:uppercase;">Level {{ level }}: {{ stage }}</p>{% endif %}
  <h2>{{ title }}</h2>
  {%- if subtitle %}<p>{{ subtitle|safe }}</p>{% endif %}
</section>
{%- endmacro -%}

{%- macro content_slide(label) -%}
{# Call-block wrapper owning the <section> + data-label, so a shared slide
   never has to name a brand-specific section class:
     {%- call content_slide("Lifecycle") %} ...body... {%- endcall %} #}
<section class="vis-slide" data-label="{{ label }}">
  {{ caller() }}
</section>
{%- endmacro -%}

{%- macro slide_heading(label, title, subtitle="") -%}
{%- if label %}<div class="vis-label">{{ label }}</div>{% endif %}
<div class="vis-title">{{ title }}</div>
{%- if subtitle %}<div class="vis-subtitle">{{ subtitle|safe }}</div>{% endif %}
{%- endmacro -%}


{# ── content primitives ───────────────────────────────────────── #}

{%- macro callout(text, accent="primary") -%}
<div class="vis-callout {{ _accent_callout_class(accent) }}" style="text-align:center;">{{ text|safe }}</div>
{%- endmacro -%}

{%- macro pros_cons(benefits, shortcomings, ben_label="Benefits", short_label="Shortcomings") -%}
<div class="vis-grid-2" style="flex:1; gap:32px;">
  <div>
    <p style="font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#22c55e; margin:0 0 14px 0;">{{ ben_label }}</p>
    <div style="display:flex; flex-direction:column; gap:10px;">
      {%- for item in benefits %}
      <div style="padding:14px 16px; border-radius:12px; background:rgba(34,197,94,0.05); border:1px solid rgba(34,197,94,0.2);">
        <p style="font-size:14px; font-weight:600; color:#fff; margin:0;">{{ item.title }}</p>
        {%- if item.detail %}<p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">{{ item.detail|safe }}</p>{% endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
  <div>
    <p style="font-size:11px; font-weight:700; letter-spacing:0.2em; text-transform:uppercase; color:#f87171; margin:0 0 14px 0;">{{ short_label }}</p>
    <div style="display:flex; flex-direction:column; gap:10px;">
      {%- for item in shortcomings %}
      <div style="padding:14px 16px; border-radius:12px; background:rgba(239,68,68,0.05); border:1px solid rgba(239,68,68,0.2);">
        <p style="font-size:14px; font-weight:600; color:#fff; margin:0;">{{ item.title }}</p>
        {%- if item.detail %}<p style="font-size:12px; color:#94a3b8; margin:4px 0 0 0;">{{ item.detail|safe }}</p>{% endif %}
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
{%- endmacro -%}

{%- macro pill_row(items, justify="center") -%}
<div style="display:flex; flex-wrap:wrap; gap:8px; justify-content:{{ justify }}; margin:10px 0 22px 0;">
  {%- for item in items %}
    {%- set a = item.accent | default("neutral") %}
    <span class="vis-mono" style="font-size:13px; padding:6px 12px; border-radius:6px; background:rgba(30,41,59,0.6); border:1px solid {{ _pill_border(a) }}; color:{{ _pill_text(a) }};">{{ item.label }}</span>
  {%- endfor %}
</div>
{%- endmacro -%}

{%- macro card(title, body, accent="neutral") -%}
<div class="{{ _accent_card_class(accent) }}" style="padding:14px;">
  {%- if title %}<p style="font-size:14px; font-weight:700; color:#fff; margin:0 0 6px 0;">{{ title }}</p>{% endif %}
  <p style="font-size:12px; color:#94a3b8; margin:0;">{{ body|safe }}</p>
</div>
{%- endmacro -%}

{%- macro card_grid(items, cols=3) -%}
<div style="display:grid; grid-template-columns:repeat({{ cols }},1fr); gap:10px;">
  {%- for item in items %}
    {{ card(item.title, item.body | default(item.detail | default("")), item.accent | default("neutral")) }}
  {%- endfor %}
</div>
{%- endmacro -%}


{%- macro pipe(stages) -%}
{# Left-to-right pipeline of stage cards joined by arrows.
   Each stage: {label, detail?, meta?, accent?, note?}

   `note` renders as an annotation hanging above the stage on a dotted
   connector. That is what lets one slide be shown twice — first with bare
   stages, then with the controls annotated onto them — from the same macro
   and the same stage list. #}
{%- set has_notes = stages | selectattr("note", "defined") | list | length > 0 %}
<div style="display:flex; align-items:stretch; justify-content:center; gap:8px; margin:18px 0;">
  {%- for stage in stages %}
  {%- if not loop.first %}
  <div aria-hidden="true" style="flex:0 0 auto; align-self:center; color:#475569; font-size:22px; line-height:1;">&rarr;</div>
  {%- endif %}
  {%- set a = stage.accent | default("neutral") %}
  <div style="flex:1 1 0; min-width:0; display:flex; flex-direction:column; align-items:stretch;">
    {%- if has_notes %}
    <div style="min-height:96px; display:flex; flex-direction:column; align-items:center; justify-content:flex-end;">
      {%- if stage.note %}
      <div style="background:rgba(15,23,42,0.85); border:1px solid {{ _accent_text(a) }}55; border-radius:8px; padding:8px 10px; text-align:center;">
        <p style="font-size:11px; font-weight:700; color:{{ _accent_text(a) }}; margin:0; line-height:1.35;">{{ stage.note|safe }}</p>
      </div>
      <div aria-hidden="true" style="width:0; height:14px; border-left:2px dotted {{ _accent_text(a) }}88;"></div>
      {%- endif %}
    </div>
    {%- endif %}
    <div class="{{ _accent_card_class(a) }}" style="flex:1; padding:16px 12px; text-align:center; display:flex; flex-direction:column; justify-content:center; gap:6px;">
      <p style="font-size:14px; font-weight:700; color:{{ _accent_text(a) }}; margin:0;">{{ stage.label }}</p>
      {%- if stage.detail %}<p style="font-size:11px; color:#94a3b8; margin:0; line-height:1.45;">{{ stage.detail|safe }}</p>{% endif %}
      {%- if stage.meta %}<p class="vis-mono" style="font-size:10px; color:#64748b; margin:0;">{{ stage.meta }}</p>{% endif %}
    </div>
  </div>
  {%- endfor %}
</div>
{%- endmacro -%}


{%- macro quote(text, attribution, source="", url="") -%}
{# Full-slide pull quote. `attribution` is the speaker; `source` is where
   they said it; `url` makes the source a link. #}
<section class="vis-slide" data-label="Quote" style="justify-content:center; align-items:center; text-align:center;">
  <div style="max-width:900px;">
    <p style="font-size:46px; font-weight:800; line-height:1.2; color:#fff; margin:0 0 28px 0;">&ldquo;{{ text|safe }}&rdquo;</p>
    <p style="font-size:18px; font-weight:700; color:#2dd4bf; margin:0;">{{ attribution }}</p>
    {%- if source %}
    <p style="font-size:13px; color:#64748b; margin:6px 0 0 0;">
      {% if url %}<a href="{{ url }}" style="color:#94a3b8;">{{ source }}</a>{% else %}{{ source }}{% endif %}
    </p>
    {%- endif %}
  </div>
</section>
{%- endmacro -%}


{%- macro matrix(headers, rows, caption="") -%}
{# Comparison matrix. Columns are the things compared, rows are the
   dimensions they are compared on.

     headers: [{label, sub?}]
     rows:    [{label, cells}]  where cells: [{level, text?}]
     level:   strong | partial | weak

   Read down a column for one option's profile; read across a row to see
   which options cover that dimension. That second reading is the point:
   it shows gaps being filled. #}
{%- set _lvl = {"strong": "success", "partial": "warning", "weak": "danger"} %}
{%- set _sym = {"strong": "●", "partial": "◐", "weak": "○"} %}
<div style="margin:14px 0;">
  <div style="display:grid; grid-template-columns:minmax(140px,1.25fr) repeat({{ headers|length }}, 1fr); gap:6px; align-items:stretch;">
    <div></div>
    {%- for h in headers %}
    <div style="text-align:center; padding:4px;">
      <p style="margin:0; font-size:13px; font-weight:700; color:#e2e8f0;">{{ h.label }}</p>
      {%- if h.sub %}<p style="margin:0; font-size:10px; color:#64748b;">{{ h.sub }}</p>{% endif %}
    </div>
    {%- endfor %}
    {%- for row in rows %}
    <div style="display:flex; align-items:center; padding:4px 8px;">
      <p style="margin:0; font-size:12px; font-weight:600; line-height:1.3; color:#e2e8f0;">{{ row.label|safe }}</p>
    </div>
    {%- for cell in row.cells %}
    {%- set a = _lvl.get(cell.level, "neutral") %}
    <div class="{{ _accent_card_class(a) }}" aria-label="{{ cell.level | default('unrated') }}"
         style="padding:8px 6px; text-align:center; display:flex; flex-direction:column; align-items:center; justify-content:center; gap:3px;">
      <span aria-hidden="true" style="font-size:15px; line-height:1; color:{{ _accent_text(a) }};">{{ _sym.get(cell.level, "○") }}</span>
      {%- if cell.text %}<p style="margin:0; font-size:10px; line-height:1.3; color:#94a3b8;">{{ cell.text|safe }}</p>{% endif %}
    </div>
    {%- endfor %}
    {%- endfor %}
  </div>
  {%- if caption %}<p style="margin:10px 0 0 0; text-align:center; font-size:11px; color:#64748b;">{{ caption|safe }}</p>{% endif %}
</div>
{%- endmacro -%}


{%- macro tradeoff_triangle(corners, note="", filled=false) -%}
{# Good / fast / cheap style triangle. `corners` is exactly three
   {label, accent}. `note` renders inside the shape. `filled` lights the
   whole triangle instead of leaving it an outline.

   Colours ride on `currentColor` so the SVG works in every pack. #}
{%- set X = [230, 420, 40] %}
{%- set Y = [46, 366, 366] %}
<div style="display:flex; justify-content:center; align-items:center; margin:10px 0;">
  <svg viewBox="0 0 460 385" role="img" aria-label="{% for c in corners %}{{ c.label }}{% if not loop.last %}, {% endif %}{% endfor %}{% if note %} — {{ note }}{% endif %}"
       style="width:min(520px,60%); height:auto; max-height:46vh;">
    <g style="color:{% if filled %}{{ _accent_text("success") }}{% else %}#475569{% endif %};">
      <polygon points="230,74 420,334 40,334"
               fill="currentColor" fill-opacity="{% if filled %}0.16{% else %}0{% endif %}"
               stroke="currentColor" stroke-width="{% if filled %}4{% else %}2.5{% endif %}"
               stroke-linejoin="round"/>
    </g>
    {%- for c in corners %}
    <g style="color:{{ _accent_text(c.accent | default("neutral")) }};">
      <text x="{{ X[loop.index0] }}" y="{{ Y[loop.index0] }}" text-anchor="middle"
            fill="currentColor" font-size="25" font-weight="700"
            font-family="inherit">{{ c.label }}</text>
    </g>
    {%- endfor %}
    {%- if note %}
    <g style="color:#94a3b8;">
      <text x="230" y="268" text-anchor="middle" fill="currentColor"
            font-size="22" font-weight="600" font-family="inherit">{{ note }}</text>
    </g>
    {%- endif %}
  </svg>
</div>
{%- endmacro -%}


